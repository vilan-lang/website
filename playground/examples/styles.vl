// Styles are compiled, not shipped: each `css { … }` block is a style the
// compiler turns into stylesheet rules at build time, and the classes below
// are their hashed names.

let card = css {
	padding(space(6));
	color(hex("#F9DFE7"));
	background(hex("#1B060D"));
	border-radius(px(12));
};

let title = css {
	margin(space(0));
	color(hex("#EB682E"));
};

fun main() {
	let _root = ui::mount_root("app", || {
		<div .styled(card)>
			<h2 .styled(title)>"Styled at compile time"</h2>
			<p>"This card's CSS came out of the compiler."</p>
		</div>
	});
}
