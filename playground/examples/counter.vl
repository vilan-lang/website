// A reactive counter: the signal is the state, the markup follows it.
// Change the label, add a second button — then press Run.

fun main() {
	ui::mount_root("app", || {
		let count = Signal::new(0);
		<div>
			<h2>"Counter"</h2>
			<button on:click(|| count.set(count.get() + 1))>"+1"</button>
			<p>{count.derive(|n| i"clicked {n} times")}</p>
		</div>
	});
}
