fun button_link(href: str, label: str): View {
	view("a")
		.styled(button_link_style)
		.attr("href", href)
		.child(pt(label))
		.child(view("img")
			.styled(link_arrow)
			.attr("src", i"{assets}/icons/move-right.svg")
			.attr("alt", ""))
}

fun docs_link(href: str, label: str): View {
	view("a")
		.styled(card_link)
		.attr("href", href)
		.child(pt(label))
		.child(view("img")
			.styled(link_arrow)
			.attr("src", i"{assets}/icons/move-right.svg")
			.attr("alt", ""))
}

// Card icons are Lucide (lucide.dev, ISC), baked with the accent stroke and
// served as plain images — `view("svg")` cannot render inline SVG today
// (`create_element` has no SVG-namespace path).
let card_icon = const (style().width(Length::px(28.0)).height(Length::px(28.0)) + no_drag);

fun feature(icon: str, name: str, href: str, body: List<View>): View {
	view("article")
		.styled(card)
		.child(view("img")
			.styled(card_icon)
			.attr("src", i"{assets}/icons/{icon}.svg")
			.attr("alt", ""))
		.child(view("h3").styled(card_title).text(name))
		.child(view("p").styled(card_body).children(body))
		.child(docs_link(href, "docs"))
}

fun feature_grid(): View {
	view("section")
		.styled(column + section_block + stack)
		.child(view("h2").styled(heading).text("Built into the language"))
		.child(view("div")
			.styled(cards_grid)
			.attr("data-glow", "")
			.child(feature("shield-check", "No null, no exceptions", "/docs/std/option-result.html", [
				pt("A missing value is an "),
				leaf_link("/docs/std/option-result.html#optiont", "Option"),
				pt(", a failure is a "),
				leaf_link("/docs/std/option-result.html#resultt-e", "Result"),
				pt(", and "),
				leaf("match"),
				pt(" makes you handle both arms. Errors are ordinary values you pass around like any other data."),
			]))
			.child(feature("copy", "Values, not references", "/docs/tour/memory-model.html", [
				pt("Assignment copies. Sharing is explicit, borrowing is checked, and spooky action at a distance is a compile error."),
			]))
			.child(feature("zap", "Async without the ceremony", "/docs/tour/async.html", [
				leaf_link("/docs/tour/async.html#opting-out-of-waiting-async-and-await", "await"),
				pt(" is implicit. Call an async function and the machinery is the compiler's problem. When you want real concurrency, tasks and "),
				leaf_link("/docs/tour/async.html#nurseries-structured-spawning", "nurseries"),
				pt(" give it structure."),
			]))
			.child(feature("layers", "One program, two platforms", "/docs/tour/platforms.html", [
				pt("One workspace compiles the node server and the browser client. The compiler tracks which code needs which platform and keeps each bundle honest."),
			]))
			.child(feature("server", "Rendered before it ships", "/docs/guide/ssr.html", [
				leaf("std::ui"),
				pt(" renders on the server too: first paint is real markup, then the client rebuilds it live. View source on this page and the content is already there."),
			]))
			.child(feature("refresh-cw", "A dev loop that keeps up", "/docs/guide/dev-loop.html", [
				leaf("vilan run . --watch"),
				pt(" rebuilds in milliseconds and hot-reloads the browser. Format, test, and language server ship in the same binary."),
			])))
}

// --- dogfood + footer ---

// Bare text against the ground — deliberately the one section with no
// panel, no art, no columns.
let dogfood_text = const style()
	.margin(space(0))
	.font_size(Length::px(15.0))
	.text_align(TextAlign::Center);

let dogfood_cta = const style().margin(space(0)).text_align(TextAlign::Center);

fun dogfood(): View {
	view("section")
		.styled(column + section_block + stack)
		.child(view("p")
			.styled(dogfood_text)
			.text("This site is a vilan program: one package, two entries. The server rendered the markup you first saw, and the browser rebuilt it live."))
		.child(view("p")
			.styled(dogfood_text)
			.text("Vilan is built to last. Semantics are settled on paper before they are implemented, and pinned by tests after. A language is a foundation, and a foundation should not move under you."))
		.child(view("p")
			.styled(dogfood_cta)
			.child(docs_link("https://github.com/vilan-lang/website", "Read this page's source")))
}

let footer_block = const style().raw("border-top", hairline).padding_y(Length::px(128.0));

let footer_grid = const style()
	.display(Display::Grid)
	.gap(space(8))
	.lg(style().raw("grid-template-columns", "2fr 1fr 1fr 1fr"));

let footer_head = const style().font_weight(600).margin_y(space(2));

let footer_list = const style()
	.display(Display::Flex)
	.flex_direction(FlexDirection::Column)
	.gap(space(2));

let footer_link = const style()
	.color(blush)
	.opacity(0.7)
	.raw("text-decoration", "none")
	.raw("user-select", "none")
	.hover(style().opacity(1.0).raw("text-decoration", "underline"));

let footer_mark = const (style()
	.raw("align-self", "center")
	.raw("justify-self", "center")
	+ no_drag);

let footer_micro = const style()
	.display(Display::Flex)
	.justify_content(JustifyContent::Between)
	.raw("flex-wrap", "wrap")
	.gap(space(2))
	.raw("border-top", hairline)
	.raw("margin-top", "96px")
	.padding_y(space(6))
	.font_size(Length::px(12.0))
	.opacity(0.55);

fun footer_column(title: str, links: List<View>): View {
	view("div")
		.child(view("p").styled(footer_head).text(title))
		.child(view("div").styled(footer_list).children(links))
}

fun page_footer(): View {
	view("footer")
		.styled(footer_block)
		.child(view("div")
			.styled(column + footer_grid)
			.child(view("img")
				.attr("src", i"{assets}/footer_mark.webp")
				.attr("alt", "The vilan mark")
				.attr("width", "200")
				.styled(footer_mark))
			.child(footer_column("Using Vilan", [
				view("a").styled(footer_link).attr("href", "#install").text("Install"),
				view("a")
					.styled(footer_link)
					.attr("href", "/docs/tour/hello-vilan.html")
					.text("Learn"),
				view("a").styled(footer_link).attr("href", "/docs/").text("Documentation"),
			]))
			.child(footer_column("Community", [
				view("a").styled(footer_link).attr("href", i"{repo}/issues").text("Issues"),
				view("a")
					.styled(footer_link)
					.attr("href", i"{repo}/discussions")
					.text("Discussions"),
				view("a")
					.styled(footer_link)
					.attr("href", "https://github.com/vilan-lang")
					.text("GitHub"),
			]))
			.child(footer_column("Terms & policies", [
				view("a")
					.styled(footer_link)
					.attr("href", i"{repo}/blob/main/CODE_OF_CONDUCT.md")
					.text("Code of Conduct"),
				view("a").styled(footer_link).attr("href", i"{repo}#license").text("Licenses"),
				view("a")
					.styled(footer_link)
					.attr("href", i"{repo}/blob/main/assets/branding/LICENSE")
					.text("Logo Policy"),
			])))
		.child(view("div")
			.styled(column)
			.child(view("div")
				.styled(footer_micro)
				.child(view("span").text("© 2026 Reed Syllas"))
				.child(view("span").text("MIT or Apache-2.0"))))
}
