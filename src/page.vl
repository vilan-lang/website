// --- showcases ---

let showcase_grid = const style().display(Display::Grid).gap(space(8)).raw("align-items", "center").lg(style().raw("grid-template-columns", "5fr 6fr"));

let showcase_grid_flipped = const style().display(Display::Grid).gap(space(8)).raw("align-items", "center").lg(style().raw("grid-template-columns", "6fr 5fr"));

let showcase_copy = const style().display(Display::Flex).flex_direction(FlexDirection::Column).gap(space(2));

fun showcase(prose: View, code: View): View {
	view("div").styled(showcase_grid).child(prose).child(code)
}

// The mirrored arm: code left, prose right — the showcases alternate so the
// page doesn't read as the same section three times.
fun showcase_flipped(code: View, prose: View): View {
	view("div").styled(showcase_grid_flipped).child(code).child(prose)
}

// Reactive UI — the guide's own counter, and a live copy of it: the snippet
// on this page is the program running beside it.

let demo_box = const style().display(Display::Flex).align_items(AlignItems::Center).gap(space(4)).margin_y(space(4)).padding(space(4)).radius(space(3)).raw("border", hairline);

let demo_button = const style().background(blush).color(ink).font_weight(600).padding_y(space(2)).padding_x(space(5)).radius(Length::px(999.0)).raw("border", "none").font_size(Length::px(14.0)).raw("font-family", body_face).raw("user-select", "none").cursor(Cursor::Pointer).hover(style().opacity(0.88));

let demo_label = const style().margin(space(0)).opacity(0.85);

fun counter_demo(): View {
	let count = Signal::new(0);
	view("div").styled(demo_box)
		.child(view("button").styled(demo_button).text("+1").on("click", || count.set_with(|n: i32| n + 1)))
		.child(view("p").styled(demo_label).bind_text(count.map(|n: i32| i"clicked {n} times")))
}

fun showcase_reactive(): View {
	view("section").styled(column + section_block)
		.child(showcase(
			view("div").styled(showcase_copy)
				.child(view("h2").styled(heading).text("UI that follows your data"))
				.child(view("p").styled(lead).text("A view is a value and a binding is a subscription: bind_text sets the one text node now and re-sets it whenever the signal changes. No virtual DOM, no render loop, no dependency arrays — updates land exactly where the data changed."))
				.child(view("p").styled(lead).text("The snippet is the whole program. This one runs — it is running right here:"))
				.child(counter_demo()),
			code_panel([
				ln([kw("import"), t(" std::ui::{ view, mount_root };")]),
				ln([kw("import"), t(" std::reactive::Signal;")]),
				blank(),
				ln([kw("fun"), t(" main() {")]),
				ln([t("    "), kw("let"), t(" count = Signal::new(0);")]),
				ln([t("    "), kw("let"), t(" _root = mount_root("), st("\"app\""), t(", || {")]),
				ln([t("        view("), st("\"div\""), t(")")]),
				ln([t("            .child(view("), st("\"p\""), t(").bind_text(count.map(|n: i32| "), st("i\"clicked {n} times\""), t(")))")]),
				ln([t("            .child(view("), st("\"button\""), t(").text("), st("\"+1\""), t(").on("), st("\"click\""), t(", || count.set_with(|n| n + 1)))")]),
				ln([t("    });")]),
				ln([t("}")]),
			])))
		.child(dataflow_art())
}

// Fullstack — the services guide's Notes server as the live diagram: the one
// definition at top, the built server and generated client below, the call
// and the mirror flowing between them.

fun showcase_fullstack(): View {
	view("section").styled(column + section_block)
		.child(view("h2").styled(heading).text("The server is a struct. The client is generated."))
		.child(view("p").styled(lead).text("Mark a method [rpc] and the browser can call it — typed, checked, awaited like any other call. Mark a signal [expose] and every connected client holds a live mirror that updates when the server writes. No REST endpoints, no fetch calls, no JSON shapes drifting out of sync by hand."))
		.child(diagram())
		.child(docs_link("/docs/guide/services.html", "Services & RPC in the guide"))
}

// The compiler — a real mistake and the real diagnostic. The snippet is the
// diagnosed file, byte for byte, so the line numbers agree.

let diag_pre = const style().background(panel).radius(space(3)).padding(space(5)).margin(space(0)).overflow(Overflow::Auto).font_size(Length::px(13.0)).line_height(1.65).raw("font-family", mono).raw("border", "1px solid rgba(235, 104, 46, 0.35)").raw("white-space", "pre");

let diag_error = const style().color(ember).font_weight(700);
let diag_frame = const style().opacity(0.5);
// min-width 0: as a grid item with no overflow of its own, min-width:auto
// would let the snippet's longest line force the column wide on phones.
let diag_stack = const style().display(Display::Flex).flex_direction(FlexDirection::Column).gap(space(3)).raw("min-width", "0");

fun showcase_compiler(): View {
	view("section").styled(column + section_block)
		.child(showcase_flipped(
			view("div").styled(diag_stack)
				.child(code_panel([
					ln([kw("import"), t(" std::print;")]),
					ln([kw("import"), t(" std::option::Option::{ self, Some, None };")]),
					ln([kw("fun"), t(" find_user(id: i32): Option<str> {")]),
					ln([t("    "), kw("if"), t(" id == 1 { Some("), st("\"Ada\""), t(") } "), kw("else"), t(" { None }")]),
					ln([t("}")]),
					ln([kw("fun"), t(" greet(name: str): str {")]),
					ln([t("    "), st("i\"hello {name}\"")]),
					ln([t("}")]),
					ln([kw("fun"), t(" main() {")]),
					ln([t("    print(greet(find_user(2)));")]),
					ln([t("}")]),
				]))
				.child(view("pre").styled(diag_pre)
					.child(ln([view("span").styled(diag_error).text("Error:"), t(" Expected str, but got Option<str> instead.")]))
					.child(ln([view("span").styled(diag_frame).text("    ╭─[ demo.vl:10:14 ]")]))
					.child(ln([view("span").styled(diag_frame).text("    │")]))
					.child(ln([view("span").styled(diag_frame).text(" 10 │     print(greet(find_user(2)));")]))
					.child(ln([view("span").styled(diag_frame).text("    │                 ──────┬────")]))
					.child(ln([view("span").styled(diag_frame).text("    │                       ╰─────── Expected str, but got Option<str> instead.")]))
					.child(ln([view("span").styled(diag_frame).text("────╯")]))),
			view("div").styled(showcase_copy)
				.child(view("h2").styled(heading).text("Find out at compile time"))
				.child(view("p").styled(lead).text("There is no null and there are no exceptions. A value that might be missing is an Option, a call that might fail returns a Result, and the compiler makes you look inside before you use one — so the failure here is a build error, not a production incident."))
				.child(view("p").styled(lead).text("Values are copied, never silently shared, so two names cannot fight over one object. The mistakes JavaScript saves for runtime are mostly not expressible."))
				.child(docs_link("/docs/std/option-result.html", "Option & Result in the reference"))))
}

// --- the editor band ---

fun editor_band(): View {
	view("section").styled(column + section_block)
		.child(showcase_flipped(
			editor_art(),
			view("div").styled(showcase_copy)
				.child(view("h2").styled(heading).text("The editor is in on it"))
				.child(view("p").styled(lead).text("vilan-lsp ships in the same binary as the compiler, so the editor and the build never disagree: diagnostics as you type, hover types and docs, completion with signatures, rename, formatting, and Organize Imports — in VS Code today, and anywhere else LSP reaches."))
				.child(view("p").styled(lead).text("Errors are resilient, not modal: a broken line keeps the rest of the file compiling, serving hovers, and completing."))
				.child(docs_link("https://github.com/vilan-lang/vilan/tree/main/editors/vscode", "The VS Code extension"))))
}

// --- feature grid ---

// One breakpoint only: std::style emits media rules in an order that lets a
// narrower min-width override a wider one on the same property (filed as a
// backlog item), so sm(2col) + lg(3col) here would render 2-col on desktop.
let cards_grid = const style().display(Display::Grid).gap(space(4)).margin_y(space(8)).lg(style().raw("grid-template-columns", "1fr 1fr 1fr"));

let card = const style().display(Display::Flex).flex_direction(FlexDirection::Column).gap(space(2)).padding(space(5)).radius(space(3)).background(panel).raw("border", hairline);

let card_title = const style().raw("font-family", display_face).font_size(Length::px(20.0)).raw("line-height", "28px").font_weight(600).margin(space(0));

let card_body = const style().margin(space(0)).opacity(0.78);

let card_link = const style().color(ember).font_size(Length::px(13.0)).raw("text-decoration", "none").raw("user-select", "none").hover(style().raw("text-decoration", "underline"));

fun docs_link(href: str, label: str): View {
	view("a").styled(card_link).attr("href", href).text(i"{label} →")
}

// Card icons are Lucide (lucide.dev, ISC), baked with the accent stroke and
// served as plain images — `view("svg")` cannot render inline SVG today
// (`create_element` has no SVG-namespace path).
let card_icon = const (style().width(Length::px(28.0)).height(Length::px(28.0)) + no_drag);

fun feature(icon: str, name: str, body: str, href: str): View {
	view("article").styled(card)
		.child(view("img").styled(card_icon).attr("src", i"{assets}/icons/{icon}.svg").attr("alt", ""))
		.child(view("h3").styled(card_title).text(name))
		.child(view("p").styled(card_body).text(body))
		.child(docs_link(href, "docs"))
}

fun feature_grid(): View {
	view("section").styled(column + section_block)
		.child(view("h2").styled(heading).text("What the language holds"))
		.child(view("div").styled(cards_grid)
			.child(feature("shield-check", "No null, no exceptions", "Option and Result are the only ways out, and match makes you handle both arms. Errors are values you route, not surprises you catch.", "/docs/std/option-result.html"))
			.child(feature("copy", "Values, not references", "Assignment copies. Sharing is explicit, borrowing is checked, and spooky action at a distance is a compile error.", "/docs/tour/memory-model.html"))
			.child(feature("zap", "Async without the ceremony", "await is implicit — call an async function and the machinery is the compiler's problem. Structured concurrency with tasks and nurseries when you want it.", "/docs/tour/async.html"))
			.child(feature("layers", "One program, two platforms", "One workspace compiles the node server and the browser client. The compiler tracks which code needs which platform and keeps each bundle honest.", "/docs/tour/platforms.html"))
			.child(feature("server", "Rendered before it ships", "std::ui renders on the server too: first paint is real markup, then the client rebuilds it live. View source on this page — it is already there.", "/docs/guide/ssr.html"))
			.child(feature("refresh-cw", "A dev loop that keeps up", "vilan run . --watch rebuilds in milliseconds and hot-reloads the browser. Format, test, and language server ship in the same binary.", "/docs/guide/dev-loop.html")))
}

// --- dogfood + footer ---

// Bare text against the ground — deliberately the one section with no
// panel, no art, no columns.
let dogfood_text = const style().margin(space(0)).font_size(Length::px(15.0)).text_align(TextAlign::Center);

let dogfood_cta = const style().margin_y(space(3)).text_align(TextAlign::Center);

fun dogfood(): View {
	view("section").styled(column + section_block)
		.child(view("p").styled(dogfood_text).text("This site is a vilan program — one package, two entries. The server rendered the markup you first saw; the browser rebuilt it live."))
		.child(view("p").styled(dogfood_cta).child(docs_link("https://github.com/vilan-lang/website", "Read this page's source")))
}

let footer_block = const style().raw("border-top", hairline).padding_y(Length::px(128.0));

let footer_grid = const style().display(Display::Grid).gap(space(8)).lg(style().raw("grid-template-columns", "2fr 1fr 1fr 1fr"));

let footer_head = const style().font_weight(600).margin_y(space(2));

let footer_list = const style().display(Display::Flex).flex_direction(FlexDirection::Column).gap(space(2));

let footer_link = const style().color(blush).opacity(0.7).raw("text-decoration", "none").raw("user-select", "none").hover(style().opacity(1.0).raw("text-decoration", "underline"));

let footer_mark = const (style().raw("align-self", "center").raw("justify-self", "center") + no_drag);

let footer_micro = const style().display(Display::Flex).justify_content(JustifyContent::Between).raw("flex-wrap", "wrap").gap(space(2)).raw("border-top", hairline).raw("margin-top", "96px").padding_y(space(6)).font_size(Length::px(12.0)).opacity(0.55);

fun footer_column(title: str, links: List<View>): View {
	view("div").child(view("p").styled(footer_head).text(title)).child(view("div").styled(footer_list).children(links))
}

fun page_footer(): View {
	view("footer").styled(footer_block)
		.child(view("div").styled(column + footer_grid)
			.child(view("img").attr("src", i"{assets}/footer_mark.webp").attr("alt", "The vilan mark").attr("width", "200").styled(footer_mark))
			.child(footer_column("Using Vilan", [
				view("a").styled(footer_link).attr("href", "#install").text("Install"),
				view("a").styled(footer_link).attr("href", "/docs/tour/hello-vilan.html").text("Learn"),
				view("a").styled(footer_link).attr("href", "/docs/").text("Documentation"),
			]))
			.child(footer_column("Community", [
				view("a").styled(footer_link).attr("href", i"{repo}/issues").text("Issues"),
				view("a").styled(footer_link).attr("href", i"{repo}/discussions").text("Discussions"),
				view("a").styled(footer_link).attr("href", "https://github.com/vilan-lang").text("GitHub"),
			]))
			.child(footer_column("Terms & policies", [
				view("a").styled(footer_link).attr("href", i"{repo}/blob/main/CODE_OF_CONDUCT.md").text("Code of Conduct"),
				view("a").styled(footer_link).attr("href", i"{repo}#license").text("Licences"),
				view("a").styled(footer_link).attr("href", i"{repo}/blob/main/assets/branding/LICENSE").text("Logo Policy"),
			])))
		.child(view("div").styled(column)
			.child(view("div").styled(footer_micro)
				.child(view("span").text("© 2026 Reed Syllas"))
				.child(view("span").text("MIT or Apache-2.0"))))
}
