// The one page both legs build: the server renders it to an HTML string for
// first paint (view source — the content is already there), the client rebuilds
// it as live DOM and replaces it on boot. Build pure, bind reactive: nothing
// here reaches for `std::dom`, so the same source compiles on both platforms.
// The client passes a live `scroll_fade` signal (the toolbar's --nav-fade,
// wired to the window in client.vl); the server passes a constant "0".
//
// Layout and art direction follow the brand's landing design (1920-logical,
// drawn at 4x) to its exact
// measurements: 64px sticky toolbar (background and divider fade in on
// scroll); 1016px hero with the mark, wordmark, and tagline 64px-gapped
// (stack top at 292); content column 1200px + 32px side padding; 1px 10%
// dividers; Vilan Display (Raleway 600, renamed) 32/48, Inter 14/18 body. Below 1920
// the hero scales proportionally; grids collapse at breakpoints.
//
// The bloom and every piece of section art are BUILT HERE as styled views —
// no image fetches, crisp at any size, animatable (the bloom drifts; the
// keyframes and the reduced-motion switch live in server.vl's `<style>`
// hatch). The only raster
// assets left are the brand marks and fonts, served from
// vilan-lang.org/assets so dev and deployed builds see the same bytes.
import std::shared::Shared;
import std::style::{
	AlignItems,
	Color,
	Cursor,
	Display,
	FlexDirection,
	JustifyContent,
	Length,
	Overflow,
	Position,
	TextAlign,
	UserSelect,
	WhiteSpace,
	space,
	style,
};
import std::time::Timer;
import pkg::art::{ dataflow_art, diagram, editor_art, toolchain_art };
import pkg::code::{ blank, code_panel, fn, hl, kw, leaf, leaf_link, ln, pt, st, t, ty };
import pkg::masthead::{ bloom, masthead };
import pkg::theme::{
	assets,
	body_face,
	code_type,
	column,
	desktop_only,
	display_face,
	divider,
	down_bright,
	down_normal,
	hairline_width,
	heading,
	lead,
	motion_ambient,
	motion_deliberate,
	no_drag,
	no_select,
	primary,
	primary_on,
	radius_float,
	radius_panel,
	repo,
	reveal,
	section_block,
	shell,
	stack,
	stroke_hard,
	stroke_soft,
	up_bright,
	up_dim,
	up_normal,
};
import pkg::topbar::top_bar;

export *;

// --- the page ---

fun page(scroll_fade: SignalCell<str>, copy: |str| void): View {
	<div .styled(shell)>
		{bloom()}
		{top_bar(scroll_fade)}
		{masthead()}
		{divider()}
		{install_section(copy)}
		{divider()}
		{showcase_reactive()}
		{divider()}
		{showcase_fullstack()}
		{divider()}
		{showcase_compiler()}
		{divider()}
		{editor_band()}
		{divider()}
		{feature_grid()}
		{divider()}
		{dogfood()}
		{page_footer()}
	</div>
}

// --- install ---

let install_label = const style()
	.font_size(Length::px(12.0))
	.font_weight(600)
	.letter_spacing(Length::em(0.12))
	.color(primary)
	.raw("text-transform", "uppercase")
	.margin_y(space(1));

// The box anchors the pinned copy button; the inner scroller carries the
// command (select-all lives on the text, not the button's container). A
// command is a code surface, so it wears `code_type` like every other one.
let install_command = const (style()
	.position(Position::Relative)
	.font_size(Length::px(13.0))
	.background(down_normal)
	.radius(radius_panel)
	.border(hairline_width, stroke_hard)
	+ code_type);

let install_command_text = const style()
	.display(Display::Block)
	.overflow(Overflow::Auto)
	.raw("scrollbar-width", "none")
	.padding_y(space(3))
	.padding_left(Length::px(16.0))
	.padding_right(Length::px(48.0))
	.white_space(WhiteSpace::Pre)
	.user_select(UserSelect::All);

// min-width 0: as a grid item, the default min-width:auto would let the
// commands' pre-formatted min-content width blow the column open on phones.
// The copy affordance lives inside the code block, docs-site style: an
// icon button in the top-right that flips to a check for a moment.
// The one genuinely floating surface in the section, so it takes the float
// radius and the raised layer; everything else here separates by hairline.
let copy_button = const (style()
	.display(Display::Flex)
	.position(Position::Absolute)
	.top(Length::px(6.0))
	.right(Length::px(8.0))
	.justify_content(JustifyContent::Center)
	.align_items(AlignItems::Center)
	.width(Length::px(28.0))
	.height(Length::px(28.0))
	.background(down_bright)
	.radius(radius_float)
	.border(hairline_width, stroke_hard)
	.transition(i"border-color {motion_ambient}, transform {motion_ambient}")
	.cursor(Cursor::Pointer)
	.hover(style().border_color(primary))
	.active(style().transform("scale(0.92)"))
	+ no_select);

let copy_icon = const (style().width(Length::px(15.0)).height(Length::px(15.0)) + no_drag);

let install_grid = const style()
	.display(Display::Flex)
	.flex_direction(FlexDirection::Column)
	.gap(space(4))
	.min_width(Length::zero());

let install_split = const (style()
	.display(Display::Grid)
	.gap(space(8))
	.align_items(AlignItems::Center)
	.lg(style().grid_template_columns("6fr 5fr"))
	+ reveal);

let install_art_cell = const (style()
	.display(Display::Hidden)
	.lg(style().display(Display::Block))
	+ no_select);

fun install_row(label: str, command: str, copy: |str| void): View {
	let icon = Signal::new(i"{assets}/icons/copy.svg");
	// Re-clicks call the pending revert off before arming the next one -
	// std::time::Timer, the API this very button drove into std.
	let pending: Shared<Option<Timer>> = Shared::new(None);
	<div>
		<p .styled(install_label)>{label}</p>
		<div .styled(install_command)>
			<span .styled(install_command_text)>{command}</span>
			<button
				.styled(copy_button)
				aria-label("Copy command")
				on:click(|| {
					copy(command);
					icon.set(i"{assets}/icons/check.svg");
					match pending.read() {
						Some(let timer) => timer.cancel(),
						None => {}
					}
					let timer = Timer::after(2400);
					pending.write() = Some(timer);
					let _ = async {
						if timer.wait() {
							icon.set(i"{assets}/icons/copy.svg");
						}
					};
				})
			>
				<img .styled(copy_icon) alt("") .bind_attr("src", icon) />
			</button>
		</div>
	</div>
}

fun install_section(copy: |str| void): View {
	<section id("install") .styled(column + section_block + stack)>
		<h2 .styled(heading)>"One command, the whole toolchain"</h2>
		<p .styled(lead)>
			{pt("The compiler, dev server with hot reload, formatter, test runner, and language server live in one small binary. There is nothing else to install and nothing to configure. Update any time with ")}
			{leaf("vilan upgrade")}
			{pt(".")}
		</p>
		<div .styled(install_split)>
			<div .styled(install_grid)>
				{install_row("macOS / Linux", "curl -fsSL https://github.com/vilan-lang/vilan/releases/latest/download/install.sh | sh", copy)}
				{install_row("Windows (PowerShell)", "irm https://github.com/vilan-lang/vilan/releases/latest/download/install.ps1 | iex", copy)}
				{install_row("Homebrew", "brew install vilan-lang/vilan/vilan", copy)}
			</div>
			<div .styled(install_art_cell)>{toolchain_art()}</div>
		</div>
	</section>
}

// --- showcases ---

let showcase_grid = const (style()
	.display(Display::Grid)
	.gap(space(8))
	.align_items(AlignItems::Center)
	.lg(style().grid_template_columns("5fr 6fr"))
	+ reveal);

let showcase_grid_flipped = const (style()
	.display(Display::Grid)
	.gap(space(8))
	.align_items(AlignItems::Center)
	.lg(style().grid_template_columns("6fr 5fr"))
	+ reveal);

let showcase_copy = const style()
	.display(Display::Flex)
	.flex_direction(FlexDirection::Column)
	.gap(space(3));

fun showcase(prose: View, code: View): View {
	<div .styled(showcase_grid)>
		{prose}
		{code}
	</div>
}

// The mirrored arm: code left, prose right — the showcases alternate so the
// page doesn't read as the same section three times.
fun showcase_flipped(code: View, prose: View): View {
	<div .styled(showcase_grid_flipped)>
		{code}
		{prose}
	</div>
}

// Reactive UI — the guide's own counter, and a live copy of it: the snippet
// on this page is the program running beside it.

let demo_box = const style()
	.display(Display::Flex)
	.gap(space(4))
	.align_items(AlignItems::Center)
	.padding(space(4))
	.margin_y(space(4))
	.radius(radius_panel)
	.border(hairline_width, stroke_hard);

// The page's one live control, so it is the page's one filled button: the
// accent as the surface, `primary-on` as what sits on it.
let demo_button = const style()
	.padding_y(space(2))
	.padding_x(space(4))
	.font_family(body_face)
	.font_size(Length::px(13.0))
	.font_weight(600)
	.color(primary_on)
	.background(primary)
	.radius(radius_panel)
	.border_none()
	.transition(i"opacity {motion_ambient}, transform {motion_ambient}")
	.cursor(Cursor::Pointer)
	.user_select(UserSelect::Off)
	.hover(style().opacity(0.88))
	.active(style().transform("scale(0.95)"));

let demo_label = const style().margin(space(0)).color(up_normal);

fun counter_demo(): View {
	let count = Signal::new(0);
	<div .styled(demo_box)>
		<button .styled(demo_button) on:click(|| count.set_with(|n: i32| n + 1))>"+1"</button>
		<p .styled(demo_label)>{count.derive(|n: i32| i"clicked {n} times")}</p>
	</div>
}

// The snippet, token by token: the playground's counter as the page tells it,
// in element syntax and the web prelude's idiom (`Signal` and `ui::` are
// ambient, so the program has no imports). tests/examples.test.mjs checks it
// and runs it; scripts/smoke-playground.mjs compiles it in the playground's
// own wasm.
fun reactive_snippet(): View {
	code_panel([
		ln([kw("fun"), t(" "), fn("main"), t("() {")]),
		ln([
			t("    "),
			kw("let"),
			t(" count = "),
			ty("Signal"),
			t("::"),
			fn("new"),
			t("("),
			st("0"),
			t(");"),
		]),
		ln([
			t("    "),
			kw("let"),
			t(" _root = ui::"),
			fn("mount_root"),
			t("("),
			st("\"app\""),
			t(", ||"),
		]),
		ln([t("        <"), ty("div"), t(">")]),
		ln([
			t("            <"),
			ty("p"),
			t(">{count."),
			fn("derive"),
			t("(|n: i32| "),
			st("i\"clicked "),
			hl("{"),
			t("n"),
			hl("}"),
			st(" times\""),
			t(")}</"),
			ty("p"),
			t(">"),
		]),
		ln([
			t("            <"),
			ty("button"),
			t(" "),
			fn("on:click"),
			t("(|| count."),
			fn("set_with"),
			t("(|n| n + "),
			st("1"),
			t("))>"),
			st("\"+1\""),
			t("</"),
			ty("button"),
			t(">"),
		]),
		ln([t("        </"), ty("div"), t(">);")]),
		ln([t("}")]),
	])
}

fun showcase_reactive(): View {
	let prose = <div .styled(showcase_copy)>
		<h2 .styled(heading)>"UI that follows your data"</h2>
		<p .styled(lead)>
			{pt("A view is a value and a binding is a subscription: a ")}
			{leaf("{signal}")}
			{pt(" hole sets the text node once, then sets it again whenever the signal changes. There is no virtual DOM, no render loop, and no dependency array to babysit. Updates land exactly where the data changed.")}
		</p>
		<p .styled(lead)>"The snippet is the whole program, and it runs. Try it right here:"</p>
		{counter_demo()}
	</div>;
	<section .styled(column + section_block + stack)>
		{showcase(prose, reactive_snippet())}
		{dataflow_art()}
	</section>
}

// Fullstack — the services guide's Notes server as the live diagram: the one
// definition at top, the built server and generated client below, the call
// and the mirror flowing between them.

fun showcase_fullstack(): View {
	<section .styled(column + section_block + stack)>
		<h2 .styled(heading)>"The server is a struct. The client is generated."</h2>
		<p .styled(lead)>
			{pt("Mark a method ")}
			{leaf_link("/docs/guide/services.html#what-rpc-calls-do", "[rpc]")}
			{pt(" and the browser can call it like any other function, typed and checked. Mark a signal ")}
			{leaf_link("/docs/guide/services.html#mirrors", "[expose]")}
			{pt(" and every connected client holds a live mirror that updates when the server writes. You never write REST endpoints, fetch calls, or the JSON shapes that drift out of sync between them.")}
		</p>
		{diagram()}
		{button_link("/docs/guide/services.html", "Services & RPC in the guide")}
	</section>
}

// The compiler — a real mistake and the real diagnostic. The snippet is the
// diagnosed file, byte for byte, so the line numbers agree.

// The terminal, quoted: a code panel whose hairline is the accent at a third
// strength, because what it is showing is a diagnostic.
let diag_pre = const (style()
	.overflow(Overflow::Auto)
	.padding(space(5))
	.margin(space(0))
	.font_size(Length::px(13.0))
	.line_height(1.65)
	.white_space(WhiteSpace::Pre)
	.background(down_normal)
	.radius(radius_panel)
	.border(hairline_width, primary.alpha(0.35))
	+ code_type);

let diag_error = const style().font_weight(700).color(primary);
// The frame the diagnostic draws around itself is scaffolding, not the
// message: the dim tier says so without an opacity.
let diag_frame = const style().color(up_dim);
// min-width 0: as a grid item with no overflow of its own, min-width:auto
// would let the snippet's longest line force the column wide on phones.
let diag_stack = const style()
	.display(Display::Flex)
	.flex_direction(FlexDirection::Column)
	.gap(space(3))
	.min_width(Length::zero());

// The diagnosed file, token by token. It has no imports: `print`, `Option`,
// `Some` and `None` are in every prelude.
fun diagnosed_snippet(): View {
	code_panel([
		ln([kw("fun"), t(" "), fn("find_user"), t("(id: i32): "), ty("Option"), t("<str> {")]),
		ln([
			t("    "),
			kw("if"),
			t(" id == "),
			st("1"),
			t(" { "),
			ty("Some"),
			t("("),
			st("\"Ada\""),
			t(") } "),
			kw("else"),
			t(" { "),
			ty("None"),
			t(" }"),
		]),
		ln([t("}")]),
		ln([kw("fun"), t(" "), fn("greet"), t("(name: str): str {")]),
		ln([t("    "), st("i\"hello "), hl("{"), t("name"), hl("}"), st("\"")]),
		ln([t("}")]),
		ln([kw("fun"), t(" "), fn("main"), t("() {")]),
		ln([
			t("    "),
			fn("print"),
			t("("),
			fn("greet"),
			t("("),
			fn("find_user"),
			t("("),
			st("2"),
			t(")));"),
		]),
		ln([t("}")]),
	])
}

// What `vilan check` says about it, quoted: tests/examples.test.mjs holds the
// two together line for line.
fun diagnostic_terminal(): View {
	<pre .styled(diag_pre)>
		{ln([
			<span .styled(diag_error)>"Error:"</span>,
			t(" Expected str, but got Option<str> instead."),
		])}
		{ln([<span .styled(diag_frame)>"   ╭─[ demo.vl:8:14 ]"</span>])}
		{ln([<span .styled(diag_frame)>"   │"</span>])}
		{ln([<span .styled(diag_frame)>" 8 │     print(greet(find_user(2)));"</span>])}
		{ln([<span .styled(diag_frame)>"   │                 ──────┬─────"</span>])}
		{ln([
			<span .styled(diag_frame)>
				"   │                       ╰─────── Expected str, but got Option<str> instead."
			</span>,
		])}
		{ln([<span .styled(diag_frame)>"───╯"</span>])}
	</pre>
}

fun showcase_compiler(): View {
	let code = <div .styled(diag_stack)>
		{diagnosed_snippet()}
		{diagnostic_terminal()}
	</div>;
	let prose = <div .styled(showcase_copy)>
		<h2 .styled(heading)>"Find out at compile time"</h2>
		<p .styled(lead)>
			{pt("Vilan has no null and no exceptions. A value that might be missing is an ")}
			{leaf_link("/docs/std/option-result.html#optiont", "Option")}
			{pt(", a call that might fail returns a ")}
			{leaf_link("/docs/std/option-result.html#resultt-e", "Result")}
			{pt(", and the compiler makes you look inside before you use either. The mistake in this snippet is a build error, not a production incident.")}
		</p>
		<p .styled(lead)>
			"Values are copied rather than silently shared, so two names never fight over one object. Most of the mistakes JavaScript saves for runtime cannot even be written."
		</p>
		{button_link("/docs/std/option-result.html", "Option & Result in the reference")}
	</div>;
	<section .styled(column + section_block + stack)>{showcase_flipped(code, prose)}</section>
}

// --- the editor band ---

fun editor_band(): View {
	let prose = <div .styled(showcase_copy)>
		<h2 .styled(heading)>"The editor is in on it"</h2>
		<p .styled(lead)>
			{leaf("vilan")}
			{pt(" and ")}
			{leaf("vilan-lsp")}
			{pt(" ship together so your editor and build never disagree. In-editor diagnostics, hover types and docs, autocompletion, Symbol Rename, formatting, and Organize Imports are all available in VS Code today.")}
		</p>
		<p .styled(lead)>
			"One broken line does not take the tooling down. The rest of the file keeps compiling, serving hovers, and completing while you fix it."
		</p>
		{button_link("https://github.com/vilan-lang/vilan/tree/main/editors/vscode", "The VS Code extension")}
	</div>;
	<section .styled(column + section_block + stack)>
		{showcase_flipped(editor_art(), prose)}
	</section>
}

// --- feature grid ---

// Two breakpoints on one property, mobile-first: 1 column on phones,
// 2 from sm, 3 from lg. Needs a toolchain where media rules emit in
// ascending min-width order (fixed 2026-07-28) — older builds rendered
// the sm value on desktop.
let cards_grid = const (style()
	.display(Display::Grid)
	.gap(space(4))
	.raw("background", "radial-gradient(340px circle at var(--glow-x, -999px) var(--glow-y, -999px), rgb(from var(--primary) r g b / 0.10), transparent 70%)")
	.sm(style().grid_template_columns("1fr 1fr"))
	.lg(style().grid_template_columns("1fr 1fr 1fr"))
	+ reveal);

// A card does not float, so it does not get a shadow or a lift (§2.2): it
// sits on the ground as its own layer, and the pointer moves it one step up
// the `down` ladder and brightens its hairline. Separation by layer and
// hairline is the whole tool-register idiom.
let card = const style()
	.display(Display::Flex)
	.flex_direction(FlexDirection::Column)
	.gap(space(2))
	.padding(space(5))
	.background(down_normal)
	.radius(radius_panel)
	.border(hairline_width, stroke_hard)
	.transition(i"background-color {motion_deliberate}, border-color {motion_deliberate}")
	.hover(style().background(down_bright).border_color(primary.alpha(0.45)));

let card_title = const style()
	.margin(space(0))
	.font_family(display_face)
	.font_size(Length::px(20.0))
	.font_weight(600)
	.line_height_length(Length::px(28.0))
	.color(up_bright);

let card_body = const style().margin(space(0)).color(up_normal);

// inline-flex, not flex: the dogfood section centers this link with
// text-align, which only reaches an inline-level box.
let card_link = const style()
	.raw("align-self", "flex-start")
	.display(Display::InlineFlex)
	.gap(space(1))
	.align_items(AlignItems::Center)
	.font_size(Length::px(13.0))
	.color(primary)
	.text_decoration("none")
	.user_select(UserSelect::Off)
	.hover(style().text_decoration("underline"));

// The links' arrow: Lucide move-right, baked ember like the card icons, so
// every "go somewhere" affordance draws its arrow the same way.
let link_arrow = const (style().width(Length::px(14.0)).height(Length::px(14.0)) + no_drag);

// The promoted form for a section's one important link: a quiet outline
// button. The pill is gone — radius is elevation now, and this sits flat on
// the ground like every other bordered thing on the page.
let button_link_style = const style()
	.raw("align-self", "flex-start")
	.display(Display::Flex)
	.gap(space(1))
	.align_items(AlignItems::Center)
	.padding_y(space(2))
	.padding_x(space(4))
	.font_size(Length::px(13.0))
	.font_weight(600)
	.color(primary)
	.text_decoration("none")
	.radius(radius_panel)
	.border(hairline_width, primary.alpha(0.45))
	.transition(i"background-color {motion_deliberate}, border-color {motion_deliberate}")
	.user_select(UserSelect::Off)
	.hover(style().background(primary.alpha(0.12)).border_color(primary));

fun button_link(href: str, label: str): View {
	<a .styled(button_link_style) href(href)>
		{pt(label)}
		<img .styled(link_arrow) src(i"{assets}/icons/move-right.svg") alt("") />
	</a>
}

fun docs_link(href: str, label: str): View {
	<a .styled(card_link) href(href)>
		{pt(label)}
		<img .styled(link_arrow) src(i"{assets}/icons/move-right.svg") alt("") />
	</a>
}

// Card icons are Lucide (lucide.dev, ISC), baked with the accent stroke and
// served as plain images. They predate `std::ui` creating `<svg>` trees in the
// SVG namespace, which it does now, so an inline icon whose stroke follows the
// theme is open to them.
let card_icon = const (style().width(Length::px(28.0)).height(Length::px(28.0)) + no_drag);

fun feature(icon: str, name: str, href: str, body: List<View>): View {
	<article .styled(card)>
		<img .styled(card_icon) src(i"{assets}/icons/{icon}.svg") alt("") />
		<h3 .styled(card_title)>{name}</h3>
		<p .styled(card_body)>{body}</p>
		{docs_link(href, "docs")}
	</article>
}

fun feature_grid(): View {
	<section .styled(column + section_block + stack)>
		<h2 .styled(heading)>"Built into the language"</h2>
		<div .styled(cards_grid) data-glow("")>
			{feature("shield-check", "No null, no exceptions", "/docs/std/option-result.html", [
				pt("A missing value is an "),
				leaf_link("/docs/std/option-result.html#optiont", "Option"),
				pt(", a failure is a "),
				leaf_link("/docs/std/option-result.html#resultt-e", "Result"),
				pt(", and "),
				leaf("match"),
				pt(" makes you handle both arms. Errors are ordinary values you pass around like any other data."),
			])}
			{feature("copy", "Values, not references", "/docs/tour/memory-model.html", [
				pt("Assignment copies. Sharing is explicit, borrowing is checked, and spooky action at a distance is a compile error."),
			])}
			{feature("zap", "Async without the ceremony", "/docs/tour/async.html", [
				leaf_link("/docs/tour/async.html#opting-out-of-waiting-async-and-await", "await"),
				pt(" is implicit. Call an async function and the machinery is the compiler's problem. When you want real concurrency, tasks and "),
				leaf_link("/docs/tour/async.html#nurseries-structured-spawning", "nurseries"),
				pt(" give it structure."),
			])}
			{feature("layers", "One program, two platforms", "/docs/tour/platforms.html", [
				pt("One workspace compiles the node server and the browser client. The compiler tracks which code needs which platform and keeps each bundle honest."),
			])}
			{feature("server", "Rendered before it ships", "/docs/guide/ssr.html", [
				leaf("std::ui"),
				pt(" renders on the server too: first paint is real markup, then the client rebuilds it live. View source on this page and the content is already there."),
			])}
			{feature("refresh-cw", "A dev loop that keeps up", "/docs/guide/dev-loop.html", [
				leaf("vilan run . --watch"),
				pt(" rebuilds in milliseconds and hot-reloads the browser. Format, test, and language server ship in the same binary."),
			])}
		</div>
	</section>
}

// --- dogfood + footer ---

// Bare text against the ground — deliberately the one section with no
// panel, no art, no columns.
let dogfood_text = const style()
	.margin(space(0))
	.font_size(Length::px(15.0))
	.text_align(TextAlign::Center);

let dogfood_cta = const style().margin(space(0)).text_align(TextAlign::Center);

fun dogfood(): View {
	<section .styled(column + section_block + stack)>
		<p .styled(dogfood_text)>
			"This site is a vilan program: one package, three entries — this page, the playground, and the server that renders both. The server rendered the markup you first saw, and the browser rebuilt it live."
		</p>
		<p .styled(dogfood_text)>
			"Vilan is built to last. Semantics are settled on paper before they are implemented, and pinned by tests after. A language is a foundation, and a foundation should not move under you."
		</p>
		<p .styled(dogfood_cta)>
			{docs_link("https://github.com/vilan-lang/website", "Read this page's source")}
		</p>
	</section>
}

let footer_block = const style()
	.padding_y(Length::px(128.0))
	.border_top(hairline_width, stroke_soft);

let footer_grid = const style()
	.display(Display::Grid)
	.gap(space(8))
	.lg(style().grid_template_columns("2fr 1fr 1fr 1fr"));

let footer_head = const style().margin_y(space(2)).font_weight(600).color(up_bright);

let footer_list = const style()
	.display(Display::Flex)
	.flex_direction(FlexDirection::Column)
	.gap(space(2));

let footer_link = const style()
	.color(up_dim)
	.text_decoration("none")
	.transition(i"color {motion_ambient}")
	.user_select(UserSelect::Off)
	.hover(style().color(up_bright).text_decoration("underline"));

let footer_mark = const (style()
	.raw("align-self", "center")
	.raw("justify-self", "center")
	+ no_drag);

let footer_micro = const style()
	.display(Display::Flex)
	.justify_content(JustifyContent::Between)
	.raw("flex-wrap", "wrap")
	.gap(space(2))
	.padding_y(space(6))
	.margin_top(Length::px(96.0))
	.font_size(Length::px(12.0))
	.color(up_dim)
	.border_top(hairline_width, stroke_soft);

fun footer_column(title: str, links: List<View>): View {
	<div>
		<p .styled(footer_head)>{title}</p>
		<div .styled(footer_list)>{links}</div>
	</div>
}

fun page_footer(): View {
	<footer .styled(footer_block)>
		<div .styled(column + footer_grid)>
			<img
				src(i"{assets}/footer_mark.webp")
				alt("The vilan mark")
				width("200")
				.styled(footer_mark)
			/>
			{footer_column("Using Vilan", [
				<a .styled(footer_link) href("#install")>"Install"</a>,
				<a .styled(footer_link) href("/docs/tour/hello-vilan.html")>"Learn"</a>,
				<a .styled(footer_link) href("/playground")>"Playground"</a>,
				<a .styled(footer_link) href("/docs/")>"Documentation"</a>,
			])}
			{footer_column("Community", [
				<a .styled(footer_link) href(i"{repo}/issues")>"Issues"</a>,
				<a .styled(footer_link) href(i"{repo}/discussions")>"Discussions"</a>,
				<a .styled(footer_link) href("https://github.com/vilan-lang")>"GitHub"</a>,
			])}
			{footer_column("Terms & policies", [
				<a .styled(footer_link) href(i"{repo}/blob/main/CODE_OF_CONDUCT.md")>
					"Code of Conduct"
				</a>,
				<a .styled(footer_link) href(i"{repo}#license")>"Licenses"</a>,
				<a .styled(footer_link) href(i"{repo}/blob/main/assets/branding/LICENSE")>
					"Logo Policy"
				</a>,
			])}
		</div>
		<div .styled(column)>
			<div .styled(footer_micro)>
				<span>"© 2026 Reed Syllas"</span>
				<span>"MIT or Apache-2.0"</span>
			</div>
		</div>
	</footer>
}
