let dg_blob_right = const (art_blob + style().raw("right", "-8%").raw("bottom", "-14%").raw("width", "38%").raw("height", "52%").raw("background", "radial-gradient(closest-side, rgba(235, 104, 46, 0.4), transparent)"));

let dg_source = const (art_card + style().max_width(Length::px(460.0)).margin_x(Length::auto()));

// The build wires: rotated hairline gradients bridging the source card to
// the legs, desktop-only (they assume the side-by-side layout).
let dg_wire_zone = const (style().position(Position::Relative).height(Length::px(64.0)) + desktop_only);

let dg_wire = const style().position(Position::Absolute).height(Length::px(2.0)).raw("transform-origin", "left center");

