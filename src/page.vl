let dg_wire_right = const (dg_wire + style().raw("left", "50%").raw("top", "8px").width(Length::px(210.0)).raw("background", "linear-gradient(to right, #D84730, #EB682E)").raw("transform", "translateX(40px) rotate(20deg)"));

