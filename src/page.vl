// The promoted form for a section's one important link: a quiet outline pill.
let button_link_style = const style()
	.raw("align-self", "flex-start")
	.display(Display::Flex)
	.align_items(AlignItems::Center)
	.color(ember)
	.font_size(Length::px(13.0))
	.font_weight(600)
	.padding_y(space(2))
	.padding_x(space(5))
	.gap(space(1))
	.radius(Length::px(999.0))
	.raw("border", "1px solid rgba(235, 104, 46, 0.45)")
	.raw("text-decoration", "none")
