let dg_leg_name = const style().raw("font-family", display_face).font_size(Length::px(15.0)).font_weight(600);

let dg_leg_env = const style().raw("margin-left", "auto").raw("font-family", mono).font_size(Length::px(11.0)).opacity(0.5);

let dg_mid = const (style().raw("display", "none").lg(style().raw("display", "flex")).flex_direction(FlexDirection::Column).justify_content(JustifyContent::Center).gap(space(4)) + no_select);

let dg_mid_label = const style().raw("font-family", mono).font_size(Length::px(11.5)).font_weight(600).color(ember).text_align(TextAlign::Center);

let dg_mid_label_rose = const style().raw("font-family", mono).font_size(Length::px(11.5)).font_weight(600).color(rose).text_align(TextAlign::Center);

let dg_line_row = const style().display(Display::Flex).align_items(AlignItems::Center);

let dg_line = const style().raw("flex", "1").height(Length::px(2.0)).raw("background", "#EB682E");

let dg_line_dashed = const style().raw("flex", "1").height(Length::px(2.0)).raw("background", "repeating-linear-gradient(90deg, #E5AFD9 0 5px, transparent 5px 11px)").raw("animation", "dash-flow 1.6s linear infinite");

let dg_note = const style().font_size(Length::px(11.0)).opacity(0.6).text_align(TextAlign::Center);

fun diagram(): View {
	view("div").styled(art_stage)
		.child(view("div").styled(dg_blob_top)).child(view("div").styled(dg_blob_left)).child(view("div").styled(dg_blob_right))
		.child(grain())
		.child(view("div").styled(dg_source)
			.child(view("p").styled(art_tab).text("notes.vl — one source"))
			.child(view("div").styled(art_code)
				.child(ln([t("["), kw("service"), t("(NotesClient)]")]))
				.child(ln([kw("struct"), t(" Notes {")]))
				.child(ln([t("    ["), kw("expose"), t("] entries: Signal<List<Note>>,")]))
				.child(ln([t("}")]))
				.child(blank())
				.child(ln([kw("impl"), t(" Notes {")]))
				.child(ln([t("    ["), kw("rpc"), t("]")]))
				.child(ln([t("    "), kw("fun"), t(" add(self, text: str): i32 { … }")]))
				.child(ln([t("}")]))))
		.child(view("div").styled(dg_wire_zone)
			.child(view("div").styled(dg_wire_left))
			.child(view("div").styled(dg_wire_right))
			.child(view("span").styled(dg_wire_label_left).text("vilan build"))
			.child(view("span").styled(dg_wire_label_right).text("vilan build")))
		.child(view("div").styled(dg_legs)
			.child(view("div").styled(art_card)
				.child(view("div").styled(dg_leg_head)
					.child(view("div").styled(dot_magenta))
					.child(view("span").styled(dg_leg_name).text("the server"))
					.child(view("span").styled(dg_leg_env).text("node")))
				.child(view("div").styled(art_code)
					.child(ln([view("span").styled(tk_plain).text("serve_service(4000,")]))
					.child(ln([t("    notes.dispatcher() …)")]))))
			.child(view("div").styled(dg_mid)
				.child(view("div")
					.child(view("p").styled(dg_mid_label).text("notes.add(\"ship it\")"))
					.child(view("div").styled(dg_line_row).child(view("div").styled(arrow_head_left)).child(view("div").styled(dg_line))))
				.child(view("div")
					.child(view("div").styled(dg_line_row).child(view("div").styled(dg_line_dashed)).child(view("div").styled(arrow_head_right_rose)))
					.child(view("p").styled(dg_mid_label_rose).text("entries"))
					.child(view("p").styled(dg_note).text("mirrored live"))))
			.child(view("div").styled(art_card)
				.child(view("div").styled(dg_leg_head)
					.child(view("div").styled(dot_orange))
					.child(view("span").styled(dg_leg_name).text("the client"))
					.child(view("span").styled(dg_leg_env).text("browser")))
				.child(view("div").styled(art_code)
					.child(ln([kw("let"), t(" notes = NotesClient::connect("), st("\"/rpc\""), t(");")]))
					.child(ln([t("notes.entries "), view("span").styled(tk_plain).text("// Signal, live")])))))
		.child(view("p").styled(art_caption).text("one definition — the compiler builds both sides and keeps them honest"))
}

