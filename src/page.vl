let df_wrap = const (style().position(Position::Relative).overflow(Overflow::Hidden).background(ink).padding_y(space(8)).raw("display", "none").lg(style().raw("display", "block")) + no_select);

let df_blob_a = const (art_blob + style().raw("left", "2%").raw("top", "-30%").raw("width", "30%").raw("height", "120%").raw("background", "radial-gradient(closest-side, rgba(139, 39, 134, 0.45), transparent)"));

let df_blob_b = const (art_blob + style().raw("right", "0%").raw("top", "-20%").raw("width", "34%").raw("height", "120%").raw("background", "radial-gradient(closest-side, rgba(216, 71, 48, 0.5), transparent)"));

