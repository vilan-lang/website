			.child(view("h2").styled(heading).text("The editor is in on it"))
			.child(view("p")
				.styled(lead)
				.child(leaf("vilan-lsp"))
				.child(pt(" ships in the same binary as the compiler, so the editor and the build never disagree: diagnostics as you type, hover types and docs, completion with signatures, rename, formatting, and Organize Imports — in VS Code today, and anywhere else LSP reaches.")))
			.child(view("p")
				.styled(lead)
				.text("Errors are resilient, not modal: a broken line keeps the rest of the file compiling, serving hovers, and completing."))
			.child(button_link("https://github.com/vilan-lang/vilan/tree/main/editors/vscode", "The VS Code extension"))))
}

