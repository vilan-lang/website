				.styled(lead)
				.child(leaf("vilan"))
				.child(pt(" and "))
				.child(leaf("vilan-lsp"))
				.child(pt(" ship together so your editor and build never disagree. In-editor diagnostics, hover types and docs, autocompletion, Symbol Rename, formatting, and Organize Imports are all available in VS Code today.")))
			.child(view("p")
