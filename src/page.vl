// The one page both legs build: the server renders it to an HTML string for
// first paint (view source — the content is already there), the client rebuilds
// it as live DOM and replaces it on boot. Build pure, bind reactive: nothing
// here reaches for `std::dom`, so the same source compiles on both platforms.
// The client passes a live `scroll_fade` signal (the toolbar's --nav-fade,
// wired to the window in client.vl); the server passes a constant "0".
//
// Layout and art direction follow the brand's landing design (1920-logical,
// drawn at 4x) to its exact
// measurements: 64px sticky toolbar (background and divider fade in on
// scroll); 1016px hero with the mark, wordmark, and tagline 64px-gapped
// (stack top at 292); content column 1200px + 32px side padding; 1px 10%
// dividers; Vilan Display (Raleway 600, renamed) 32/48, Inter 14/18 body. Below 1920
// the hero scales proportionally; grids collapse at breakpoints.
//
// The bloom and every piece of section art are BUILT HERE as styled views —
// no image fetches, crisp at any size, animatable (the bloom drifts; the
// keyframes and the reduced-motion switch live in app.html). The only raster
// assets left are the brand marks and fonts, served from
// vilan-lang.org/assets so dev and deployed builds see the same bytes.
import std::option::Option::{ None, Some, self };
import std::reactive::Signal;
import std::shared::Shared;
import std::style::{ AlignItems, Color, Cursor, Display, FlexDirection, JustifyContent, Length, Overflow, Position, TextAlign, space, style };
import std::time::Timer;
import std::ui::{ View, view };
import pkg::art::{ dataflow_art, diagram, editor_art, toolchain_art };
import pkg::code::{ blank, code_panel, kw, leaf, leaf_link, ln, pt, st, t };
import pkg::masthead::{ bloom, masthead, top_bar };
import pkg::theme::{ assets, blush, body_face, column, desktop_only, display_face, divider, ember, hairline, heading, ink, lead, mono, no_drag, no_select, panel, repo, reveal, rose, section_block, shell, stack };

// --- the page ---

fun page(scroll_fade: Signal<str>, copy: |str| void): View {
	view("div")
		.styled(shell)
		.child(bloom())
		.child(top_bar(scroll_fade))
		.child(masthead())
		.child(divider())
		.child(install_section(copy))
		.child(divider())
		.child(showcase_reactive())
		.child(divider())
		.child(showcase_fullstack())
		.child(divider())
		.child(showcase_compiler())
		.child(divider())
		.child(editor_band())
		.child(divider())
		.child(feature_grid())
		.child(divider())
		.child(dogfood())
		.child(page_footer())
}

