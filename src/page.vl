	view("div").styled(showcase_grid_flipped).child(code).child(prose)
}

// Reactive UI — the guide's own counter, and a live copy of it: the snippet
// on this page is the program running beside it.

let demo_box = const style()
	.display(Display::Flex)
	.align_items(AlignItems::Center)
	.gap(space(4))
	.margin_y(space(4))
	.padding(space(4))
	.radius(space(3))
	.raw("border", hairline);

let demo_button = const style()
	.background(blush)
	.color(ink)
	.font_weight(600)
	.padding_y(space(2))
	.padding_x(space(5))
	.radius(Length::px(999.0))
	.raw("border", "none")
	.font_size(Length::px(14.0))
	.raw("font-family", body_face)
	.raw("user-select", "none")
	.cursor(Cursor::Pointer)
	.transition("transform 120ms ease, opacity 120ms ease")
	.hover(style().opacity(0.88))
	.active(style().raw("transform", "scale(0.95)"));

let demo_label = const style().margin(space(0)).opacity(0.85);

fun counter_demo(): View {
	let count = Signal::new(0);
	view("div")
		.styled(demo_box)
		.child(view("button")
			.styled(demo_button)
			.text("+1")
			.on("click", || count.set_with(|n: i32| n + 1)))
		.child(view("p").styled(demo_label).bind_text(count.map(|n: i32| i"clicked {n} times")))
}

fun showcase_reactive(): View {
	view("section")
		.styled(column + section_block + stack)
		.child(showcase(view("div").styled(showcase_copy).child(view("h2").styled(heading).text("UI that follows your data")).child(view("p").styled(lead).child(pt("A view is a value and a binding is a subscription: ")).child(leaf("bind_text")).child(pt(" sets the one text node now and re-sets it whenever the signal changes. No virtual DOM, no render loop, no dependency arrays — updates land exactly where the data changed."))).child(view("p").styled(lead).text("The snippet is the whole program. This one runs — it is running right here:")).child(counter_demo()), code_panel([
			ln([kw("import"), t(" std::ui::{ view, mount_root };")]),
			ln([kw("import"), t(" std::reactive::Signal;")]),
			blank(),
			ln([kw("fun"), t(" main() {")]),
			ln([t("    "), kw("let"), t(" count = Signal::new(0);")]),
			ln([t("    "), kw("let"), t(" _root = mount_root("), st("\"app\""), t(", || {")]),
			ln([t("        view("), st("\"div\""), t(")")]),
			ln([
				t("            .child(view("),
				st("\"p\""),
				t(").bind_text(count.map(|n: i32| "),
				st("i\"clicked {n} times\""),
				t(")))"),
			]),
			ln([
				t("            .child(view("),
				st("\"button\""),
				t(").text("),
				st("\"+1\""),
				t(").on("),
				st("\"click\""),
				t(", || count.set_with(|n| n + 1)))"),
			]),
			ln([t("    });")]),
			ln([t("}")]),
		])))
		.child(dataflow_art())
}

// Fullstack — the services guide's Notes server as the live diagram: the one
// definition at top, the built server and generated client below, the call
// and the mirror flowing between them.

fun showcase_fullstack(): View {
	view("section")
		.styled(column + section_block + stack)
		.child(view("h2").styled(heading).text("The server is a struct. The client is generated."))
		.child(view("p")
			.styled(lead)
			.child(pt("Mark a method "))
			.child(leaf_link("/docs/guide/services.html#what-rpc-calls-do", "[rpc]"))
			.child(pt(" and the browser can call it — typed, checked, awaited like any other call. Mark a signal "))
			.child(leaf_link("/docs/guide/services.html#mirrors", "[expose]"))
			.child(pt(" and every connected client holds a live mirror that updates when the server writes. No REST endpoints, no fetch calls, no JSON shapes drifting out of sync by hand.")))
		.child(diagram())
		.child(button_link("/docs/guide/services.html", "Services & RPC in the guide"))
}

// The compiler — a real mistake and the real diagnostic. The snippet is the
// diagnosed file, byte for byte, so the line numbers agree.

let diag_pre = const style()
	.background(panel)
	.radius(space(3))
	.padding(space(5))
	.margin(space(0))
	.overflow(Overflow::Auto)
	.font_size(Length::px(13.0))
	.line_height(1.65)
	.raw("font-family", mono)
	.raw("border", "1px solid rgba(235, 104, 46, 0.35)")
	.raw("white-space", "pre");

let diag_error = const style().color(ember).font_weight(700);
let diag_frame = const style().opacity(0.5);
// min-width 0: as a grid item with no overflow of its own, min-width:auto
// would let the snippet's longest line force the column wide on phones.
let diag_stack = const style()
	.display(Display::Flex)
	.flex_direction(FlexDirection::Column)
	.gap(space(3))
	.raw("min-width", "0");

fun showcase_compiler(): View {
	view("section")
		.styled(column + section_block + stack)
		.child(showcase_flipped(view("div").styled(diag_stack).child(code_panel([ln([kw("import"), t(" std::print;")]), ln([kw("import"), t(" std::option::Option::{ self, Some, None };")]), ln([kw("fun"), t(" find_user(id: i32): Option<str> {")]), ln([t("    "), kw("if"), t(" id == 1 { Some("), st("\"Ada\""), t(") } "), kw("else"), t(" { None }")]), ln([t("}")]), ln([kw("fun"), t(" greet(name: str): str {")]), ln([t("    "), st("i\"hello {name}\"")]), ln([t("}")]), ln([kw("fun"), t(" main() {")]), ln([t("    print(greet(find_user(2)));")]), ln([t("}")])])).child(view("pre").styled(diag_pre).child(ln([view("span").styled(diag_error).text("Error:"), t(" Expected str, but got Option<str> instead.")])).child(ln([view("span").styled(diag_frame).text("    ╭─[ demo.vl:10:14 ]")])).child(ln([view("span").styled(diag_frame).text("    │")])).child(ln([view("span").styled(diag_frame).text(" 10 │     print(greet(find_user(2)));")])).child(ln([view("span").styled(diag_frame).text("    │                 ──────┬────")])).child(ln([view("span").styled(diag_frame).text("    │                       ╰─────── Expected str, but got Option<str> instead.")])).child(ln([view("span").styled(diag_frame).text("────╯")]))), view("div")
			.styled(showcase_copy)
			.child(view("h2").styled(heading).text("Find out at compile time"))
			.child(view("p")
				.styled(lead)
				.child(pt("There is no null and there are no exceptions. A value that might be missing is an "))
				.child(leaf_link("/docs/std/option-result.html#optiont", "Option"))
				.child(pt(", a call that might fail returns a "))
				.child(leaf_link("/docs/std/option-result.html#resultt-e", "Result"))
				.child(pt(", and the compiler makes you look inside before you use one — so the failure here is a build error, not a production incident.")))
			.child(view("p")
				.styled(lead)
				.text("Values are copied, never silently shared, so two names cannot fight over one object. The mistakes JavaScript saves for runtime are mostly not expressible."))
			.child(button_link("/docs/std/option-result.html", "Option & Result in the reference"))))
}

// --- the editor band ---

fun editor_band(): View {
	view("section")
