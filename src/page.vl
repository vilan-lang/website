let install_command = const style()
	.position(Position::Relative)
	.background(panel)
	.radius(space(2))
	.font_size(Length::px(13.0))
	.raw("font-family", mono)
	.raw("border", hairline);

let install_command_text = const style()
	.raw("display", "block")
	.overflow(Overflow::Auto)
	.raw("scrollbar-width", "none")
	.raw("white-space", "pre")
	.padding_y(space(3))
	.raw("padding-left", "16px")
	.raw("padding-right", "48px")
	.raw("user-select", "all");

// min-width 0: as a grid item, the default min-width:auto would let the
// commands' pre-formatted min-content width blow the column open on phones.
// The copy affordance lives inside the code block, docs-site style: an
// icon button in the top-right that flips to a check for a moment.
let copy_button = const (style()
	.position(Position::Absolute)
	.raw("top", "6px")
	.raw("right", "8px")
	.display(Display::Flex)
	.align_items(AlignItems::Center)
	.justify_content(JustifyContent::Center)
	.width(Length::px(30.0))
	.height(Length::px(30.0))
	.radius(Length::px(8.0))
	.raw("background", "rgba(27, 6, 13, 0.85)")
	.raw("border", hairline)
	.cursor(Cursor::Pointer)
	.transition("border-color 140ms ease, transform 120ms ease")
	.hover(style().raw("border-color", "rgba(235, 104, 46, 0.6)"))
	.active(style().raw("transform", "scale(0.92)"))
	+ no_select);

let copy_icon = const (style().width(Length::px(15.0)).height(Length::px(15.0)) + no_drag);

let install_grid = const style()
	.display(Display::Flex)
	.flex_direction(FlexDirection::Column)
	.gap(space(4))
	.raw("min-width", "0");

let install_split = const (style()
	.display(Display::Grid)
	.gap(space(8))
	.raw("align-items", "center")
	.lg(style().raw("grid-template-columns", "6fr 5fr"))
	+ reveal);

let install_art_cell = const (style()
	.raw("display", "none")
	.lg(style().raw("display", "block"))
	+ no_select);

fun install_row(label: str, command: str, copy: |str| void): View {
	let icon = Signal::new(i"{assets}/icons/copy.svg");
	// Re-clicks call the pending revert off before arming the next one -
	// std::time::Timer, the API this very button drove into std.
	let pending: Shared<Option<Timer>> = Shared::new(None);
	view("div").child(view("p").styled(install_label).text(label)).child(view("div").styled(install_command).child(view("span").styled(install_command_text).text(command)).child(view("button").styled(copy_button).attr("aria-label", "Copy command").on("click", || {
		copy(command);
		icon.set(i"{assets}/icons/check.svg");
		match pending.read() {
			Some(let timer) => timer.cancel(),
			None => {}
		}
		let timer = Timer::after(2400);
		pending.write() = Some(timer);
		let _ = async {
			if timer.wait() {
				icon.set(i"{assets}/icons/copy.svg");
			}
		};
	}).child(view("img").styled(copy_icon).attr("alt", "").bind_attr("src", icon))))
}

fun install_section(copy: |str| void): View {
	view("section")
		.attr("id", "install")
		.styled(column + section_block + stack)
		.child(view("h2").styled(heading).text("One command, the whole toolchain"))
		.child(view("p")
			.styled(lead)
			.child(pt("The compiler, dev server with hot reload, formatter, test runner, and language server live in one small binary. There is nothing else to install and nothing to configure. Update any time with "))
			.child(leaf("vilan upgrade"))
			.child(pt(".")))
		.child(view("div")
			.styled(install_split)
			.child(view("div")
				.styled(install_grid)
				.child(install_row("macOS / Linux", "curl -fsSL https://github.com/vilan-lang/vilan/releases/latest/download/install.sh | sh", copy))
				.child(install_row("Windows (PowerShell)", "irm https://github.com/vilan-lang/vilan/releases/latest/download/install.ps1 | iex", copy))
				.child(install_row("Homebrew", "brew install vilan-lang/vilan/vilan", copy)))
			.child(view("div").styled(install_art_cell).child(toolchain_art())))
}

