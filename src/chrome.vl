// The chrome export: the masthead rendered once, as a fragment, for the book —
// and the token generator (K10, design-language.md §2.6).
//
// vilan-lang.org/docs/ is mdBook's output, not this package's — but its pages
// should wear the same masthead as the landing page and the playground, and
// that masthead must never be hand-copied (its classes are build hashes). So
// this leg renders `top_bar` through the same SSR path the server uses and
// writes the result out as files the pages repo serves under /chrome/:
//
//   header.html  the rendered <nav>, one root element, nothing around it —
//                what the book's docs.yml copies in as theme/header.hbs
//   header.css   this leg's own emitted stylesheet: exactly the rules the
//                masthead reaches and no other — what the book's head.hbs
//                links
//   tokens.css   the whole themed palette, generated from theme.vl's
//                `themed_values` table in BOTH forms a consumer needs: the
//                site's own `prefers-color-scheme` form (the exact strings
//                the compiled stylesheets carry — `themed_declaration` is
//                the one formatter for both), then the class-scoped
//                `html.navy` / `html.light` form, the book's picker model.
//                Nothing links it yet by design: the book stays standalone
//                (its `variables.css` is gated instead — see below), and the
//                docs port (K13), kolt, or any later consumer takes it here.
//
// It also writes one file the deploy does NOT stage:
//
//   tokens-fixture.css  the class-scoped form under a provenance header,
//                       byte-for-byte what the vilan repo commits as
//                       vilan/docs/theme/css/tokens-fixture.css — the fixture
//                       its suite holds the book's variables.css to
//                       (crates/vilan-cli/tests/book_mirrors.rs). When
//                       theme.vl moves, regenerate by copy, never by edit.
//
// The masthead stylesheet names every colour as a `var(--role)` and declares
// the site's defaults at `:root` (specificity 0,1,0). The book declares the
// same roles on `html.light` / `html.navy`, later in its <head> and one level
// more specific, so the masthead follows whichever theme the BOOK is showing —
// the fragment takes the host's palette, never brings its own. Usage:
//
//   node dist/chrome.mjs <out-dir>      (deploy.yml: export/chrome)

import std::fs;
import std::print;
import std::process::args;
import std::reactive::{ Owner, Signal, run_with_owner };
import std::ui::render;
import pkg::theme::{ themed_declaration, themed_values };
import pkg::topbar::top_bar;

/// The palette on one theme class — the book's model: `html.navy { … }` with
/// every themed value's dark column, `html.light { … }` with its light one.
fun navy_block(): str {
	mut body = "";
	for value in themed_values {
		body = i"{body}\t--{value.name}: {value.dark};\n";
	}
	i"html.navy \{\n{body}\}\n"
}

fun light_block(): str {
	mut body = "";
	for value in themed_values {
		body = i"{body}\t--{value.name}: {value.light};\n";
	}
	i"html.light \{\n{body}\}\n"
}

/// The site's own form: one `:root{…}@media (prefers-color-scheme: light){…}`
/// line per themed value — the same strings `token` compiles into every
/// entry's stylesheet, from the same formatter.
fun root_form(): str {
	mut lines = "";
	for value in themed_values {
		lines = i"{lines}{themed_declaration(value)}\n";
	}
	lines
}

fun tokens_stylesheet(): str {
	let header = "/* GENERATED by the website's chrome leg (src/chrome.vl) from src/theme.vl's\n" + " * `themed_values` table — do not edit. Regenerate:\n" + " *   vilan build . && node dist/chrome.mjs export/chrome\n" + " *\n" + " * The whole themed palette, in both forms a consumer needs\n" + " * (design-language.md §2.6): first the site's own form — each token\n" + " * declared at `:root` with its light value behind `prefers-color-scheme:\n" + " * light` — then the class-scoped form on `html.navy` / `html.light` (the\n" + " * book's picker model), which beats the `:root` form by specificity\n" + " * wherever both load. */\n";
	i"{header}\n{root_form()}\n{navy_block()}\n{light_block()}"
}

fun tokens_fixture(): str {
	let header = "/* GENERATED by the website's chrome leg (src/chrome.vl) from src/theme.vl's\n" + " * `themed_values` table — do not edit by hand. Committed in the vilan repo\n" + " * as vilan/docs/theme/css/tokens-fixture.css, where the suite holds the\n" + " * book's variables.css to it (crates/vilan-cli/tests/book_mirrors.rs).\n" + " * Regenerate, from the website repo root (the vilan repo checked out\n" + " * beside it):\n" + " *   vilan build . && node dist/chrome.mjs export/chrome\n" + " *   cp export/chrome/tokens-fixture.css ../vilan/vilan/docs/theme/css/tokens-fixture.css\n" + " */\n";
	i"{header}\n{navy_block()}\n{light_block()}"
}

async fun main() {
	let out = args()[0];
	// The bar at full fade: the page under it is the book's, which scrolls
	// the whole page rather than its content, so the sticky bar always sits
	// on a painted ground — the same constant the playground page passes.
	let owner = Owner::new();
	mut markup = "";
	run_with_owner(owner, || {
		markup = render(top_bar(Signal::new("1")));
	});
	fs::write_file(i"{out}/header.html", markup);
	// The stylesheet is the compiler's, already scoped to this leg: the
	// build emits one per entry holding only the rules that entry reaches.
	fs::write_file(i"{out}/header.css", fs::read_file_to_str("dist/chrome.css"));
	fs::write_file(i"{out}/tokens.css", tokens_stylesheet());
	fs::write_file(i"{out}/tokens-fixture.css", tokens_fixture());
	print(i"chrome: {out}/header.html + header.css + tokens.css + tokens-fixture.css");
}
