let tc_center = const (style()
	.position(Position::Absolute)
	.left(Length::pct(50.0))
	.top(Length::pct(50.0))
	.transform("translate(-50%, -50%)")
	.width(Length::px(140.0))
	.height(Length::auto())
	+ no_drag);

fun tc_chip_at(left: str, top: str, color: str, label: str): View {
	view("div")
		.styled(tc_chip)
		.attr("style", i"left: {left}; top: {top}")
		.child(view("div").styled(led).attr("style", i"background: {color}"))
		.child(view("span").text(label))
}

fun toolchain_art(): View {
	view("div")
		.styled(tc_wrap)
		.child(view("div").styled(tc_blob_b))
		.child(view("div").styled(tc_blob_a))
		.child(view("div").styled(tc_blob_c))
		.child(grain())
		.child(view("div").styled(tc_spoke_up))
		.child(view("div").styled(tc_spoke_down))
		.child(view("div").styled(tc_spoke_run))
		.child(view("div").styled(tc_spoke_fmt))
		.child(view("div").styled(tc_spoke_lsp))
		.child(view("div").styled(tc_spoke_upgrade))
		.child(view("div").styled(tc_center_mask))
		.child(view("img")
			.styled(tc_center)
			.attr("src", i"{assets}/wordmark_hero_light.svg")
			.attr("alt", "vilan"))
		.child(tc_chip_at("210px", "70px", "#EB682E", "vilan build"))
		.child(tc_chip_at("346px", "142px", "#D84730", "vilan run --watch"))
		.child(tc_chip_at("344px", "288px", "#E5AFD9", "vilan fmt"))
		.child(tc_chip_at("210px", "360px", "#B23056", "vilan test"))
		.child(tc_chip_at("78px", "288px", "#8B2786", "vilan-lsp"))
		.child(tc_chip_at("82px", "142px", "#672283", "vilan upgrade"))
}

// --- the dataflow strip (reactive section, desktop only) ---

let df_wrap = const (style()
	.position(Position::Relative)
	.overflow(Overflow::Hidden)
	.padding_y(space(8))
	.display(Display::Hidden)
	.lg(style().display(Display::Block))
	+ art_canvas
	+ no_select);

let df_blob_a = const (art_blob + style()
	.left(Length::pct(2.0))
	.top(Length::pct(-30.0))
	.width(Length::pct(30.0))
	.height(Length::pct(120.0))
	.background_gradient(Gradient::radial(RadialExtent::ClosestSide)
		.stop(Color::rgba(139, 39, 134, 0.45), 0.0)
		.stop(Color::transparent(), 100.0)));

let df_blob_b = const (art_blob + style()
	.right(Length::pct(0.0))
	.top(Length::pct(-20.0))
	.width(Length::pct(34.0))
	.height(Length::pct(120.0))
	.background_gradient(Gradient::radial(RadialExtent::ClosestSide)
		.stop(Color::rgba(216, 71, 48, 0.5), 0.0)
		.stop(Color::transparent(), 100.0)));

let df_row = const style()
	.position(Position::Relative)
	.display(Display::Flex)
	.align_items(AlignItems::Center)
	.gap(space(4));

let df_node = const (art_card + style().radius(Length::px(12.0)));

let df_node_lit = const (df_node + style()
	.border_color(Color::hex("rgba(235, 104, 46, 0.6)"))
	.box_shadow("0 0 34px rgba(235, 104, 46, 0.25), 0 8px 32px rgba(0, 0, 0, 0.45)"));

let df_tag = const style()
	.font_size(Length::px(10.5))
	.font_weight(600)
	.letter_spacing(Length::em(0.1))
	.raw("text-transform", "uppercase")
	.opacity(0.5)
	.margin_y(space(1));

let df_arrow = const style()
	.flex("1")
	.display(Display::Flex)
	.flex_direction(FlexDirection::Column)
	.align_items(AlignItems::Center)
	.gap(space(1));

let df_arrow_label = const style()
	.font_family(mono)
	.font_size(Length::px(11.5))
	.font_weight(600)
	.color(ember);

let df_arrow_row = const style()
	.display(Display::Flex)
	.align_items(AlignItems::Center)
	.width(Length::pct(100.0));

fun df_arrow_to(label: str): View {
	view("div")
		.styled(df_arrow)
		.child(view("span").styled(df_arrow_label).text(label))
		.child(view("div")
			.styled(df_arrow_row)
			.child(view("div").styled(dg_line))
			.child(view("div").styled(arrow_head_right)))
}

fun df_node_view(lit: bool, tag: str, body: List<View>): View {
	view("div")
		.styled(if lit {
			df_node_lit
		} else {
			df_node
		})
		.child(view("p").styled(df_tag).text(tag))
		.child(view("div").styled(art_code).child(ln(body)))
}

fun dataflow_art(): View {
	view("div")
		.styled(df_wrap)
		.child(view("div").styled(df_blob_a))
		.child(view("div").styled(df_blob_b))
		.child(grain())
		.child(view("div")
			.styled(df_row)
			.child(df_node_view(false, "the write", [t("count.set("), st("2"), t(")")]))
			.child(df_arrow_to("notify"))
			.child(df_node_view(false, "the signal", [t("Signal<i32> "), kw("= 2")]))
			.child(df_arrow_to("re-set"))
			.child(df_node_view(true, "the one text node", [
				t("<p>clicked "),
				kw("2"),
				t(" times</p>"),
			])))
		.child(view("p")
			.styled(art_caption)
			.text("no virtual DOM, no re-render: the subscription updates exactly one node"))
}
