	.top(Length::px(215.0))
	.width(Length::px(153.0))
	.height(Length::px(1.0))
	.transform("rotate(28.6deg)"));
let tc_spoke_lsp = const (tc_spoke + style()
	.left(Length::px(210.0))
	.top(Length::px(215.0))
	.width(Length::px(150.0))
	.height(Length::px(1.0))
	.transform("rotate(151deg)"));
let tc_spoke_upgrade = const (tc_spoke + style()
	.left(Length::px(210.0))
	.top(Length::px(215.0))
	.width(Length::px(147.0))
	.height(Length::px(1.0))
	.transform("rotate(-150.3deg)"));

let tc_chip = const style()
	.display(Display::Flex)
	.position(Position::Absolute)
	.gap(space(2))
	.align_items(AlignItems::Center)
	.padding_y(space(2))
	.padding_x(space(4))
	.font_family(code_face)
	.font_size(Length::px(12.5))
	.white_space(WhiteSpace::Nowrap)
	.background(down_normal.alpha(0.92))
	.radius(Length::px(999.0))
	.border(Length::px(1.0), up_bright.alpha(0.16))
	.box_shadow(shade("0 6px 28px", 0.45))
	.transform("translate(-50%, -50%)");

let led = const style()
	.flex_shrink(0.0)
	.width(Length::px(7.0))
	.height(Length::px(7.0))
	.radius(Length::pct(50.0));

// A fade of the ground behind the wordmark so the spokes read as arriving at
// it, not crossing through it.
let tc_center_mask = const style()
	.position(Position::Absolute)
	.left(Length::pct(50.0))
	.top(Length::pct(50.0))
	.width(Length::px(250.0))
	.height(Length::px(140.0))
	.background_gradient(Gradient::radial(RadialExtent::ClosestSide)
		.stop(down_dim.alpha(0.84), 35.0)
		.stop(Color::transparent(), 100.0))
	.transform("translate(-50%, -50%)");

// The wordmark follows `up-bright`, like the nav's mark: the asset is one
// colour (blush), so it is drawn as a mask over the role rather than as an
// <img> that would stay blush on the light ground. 311x64 is the asset's own
// box, so 140px wide is the same 28.8px tall the image was.
let tc_center = const (style()
	.position(Position::Absolute)
	.left(Length::pct(50.0))
	.top(Length::pct(50.0))
	.width(Length::px(140.0))
	.transform("translate(-50%, -50%)")
	.raw("aspect-ratio", "311 / 64")
	.background(up_bright)
	.raw("-webkit-mask", i"url({assets}/wordmark_hero_light.svg) center / contain no-repeat")
	.raw("mask", i"url({assets}/wordmark_hero_light.svg) center / contain no-repeat")
	+ no_drag);

/// A chip centred at (`left`, `top`) — the end of its spoke — with its LED in
/// `color`: a role's `var()` or a literal hex, the inline style takes either.
fun tc_chip_at(left: str, top: str, color: str, label: str): View {
	view("div")
		.styled(tc_chip)
		.attr("style", i"left: {left}; top: {top}")
		.child(view("div").styled(led).attr("style", i"background: {color}"))
		.child(view("span").text(label))
}

fun toolchain_art(): View {
	view("div")
		.styled(tc_wrap)
		.child(view("div").styled(tc_blob_b))
		.child(view("div").styled(tc_blob_a))
		.child(view("div").styled(tc_blob_c))
		.child(grain())
		.child(view("div").styled(tc_spoke_up))
		.child(view("div").styled(tc_spoke_down))
		.child(view("div").styled(tc_spoke_run))
		.child(view("div").styled(tc_spoke_fmt))
		.child(view("div").styled(tc_spoke_lsp))
		.child(view("div").styled(tc_spoke_upgrade))
		.child(view("div").styled(tc_center_mask))
		.child(view("div").styled(tc_center).attr("role", "img").attr("aria-label", "vilan"))
		// The LEDs are each tool's colour from the bloom: ember and rose as
		// their roles, the rest literal. `vilan run --watch` is the widest chip
		// (~176px), so it sits 18px in from its spoke's end — centred there it
		// overran the 420px canvas by 14px; the spoke still ends under it.
		.child(tc_chip_at("210px", "70px", primary.text, "vilan build"))
		.child(tc_chip_at("328px", "142px", "#D84730", "vilan run --watch"))
		.child(tc_chip_at("344px", "288px", accent.text, "vilan fmt"))
		.child(tc_chip_at("210px", "360px", "#B23056", "vilan test"))
		.child(tc_chip_at("78px", "288px", "#8B2786", "vilan-lsp"))
		.child(tc_chip_at("82px", "142px", "#672283", "vilan upgrade"))
}

// --- the dataflow strip (reactive section, desktop only) ---

let df_wrap = const (style()
	.display(Display::Hidden)
	.overflow(Overflow::Hidden)
	.position(Position::Relative)
	.padding_y(space(8))
	.lg(style().display(Display::Block))
	+ art_canvas
	+ no_select);

let df_blob_a = const (art_blob + style()
	.left(Length::pct(2.0))
	.top(Length::pct(-30.0))
	.width(Length::pct(30.0))
	.height(Length::pct(120.0))
	.background_gradient(Gradient::radial(RadialExtent::ClosestSide)
		.stop(Color::rgba(139, 39, 134, 0.45), 0.0)
		.stop(Color::transparent(), 100.0)));

let df_blob_b = const (art_blob + style()
	.right(Length::pct(0.0))
	.top(Length::pct(-20.0))
	.width(Length::pct(34.0))
	.height(Length::pct(120.0))
	.background_gradient(Gradient::radial(RadialExtent::ClosestSide)
		.stop(Color::rgba(216, 71, 48, 0.5), 0.0)
		.stop(Color::transparent(), 100.0)));

let df_row = const style()
	.display(Display::Flex)
	.position(Position::Relative)
	.gap(space(4))
	.align_items(AlignItems::Center);

let df_node = const (art_card + style().radius(Length::px(12.0)));

// The lit node glows `primary`: a border at .6 and a halo at .25 over the
// card's own shadow.
let df_node_lit = const (df_node + style()
	.border_color(primary.alpha(0.6))
	.box_shadow(i"0 0 34px {primary.alpha(0.25).text}, {shade("0 8px 32px", 0.45)}"));

let df_tag = const style()
	.font_size(Length::px(10.5))
	.font_weight(600)
	.letter_spacing(Length::em(0.1))
	.raw("text-transform", "uppercase")
	.margin_y(space(1))
	.opacity(0.5);

let df_arrow = const style()
	.display(Display::Flex)
	.flex_direction(FlexDirection::Column)
	.flex("1")
	.gap(space(1))
	.align_items(AlignItems::Center);

let df_arrow_label = const style()
	.font_family(code_face)
	.font_size(Length::px(11.5))
	.font_weight(600)
	.color(primary);

let df_arrow_row = const style()
	.display(Display::Flex)
	.align_items(AlignItems::Center)
	.width(Length::pct(100.0));

fun df_arrow_to(label: str): View {
	view("div")
		.styled(df_arrow)
		.child(view("span").styled(df_arrow_label).text(label))
		.child(view("div")
			.styled(df_arrow_row)
			.child(view("div").styled(dg_line))
			.child(view("div").styled(arrow_head_right)))
}

fun df_node_view(lit: bool, tag: str, body: List<View>): View {
	view("div")
		.styled(if lit {
			df_node_lit
		} else {
			df_node
		})
		.child(view("p").styled(df_tag).text(tag))
		.child(view("div").styled(art_code).child(ln(body)))
}

fun dataflow_art(): View {
	view("div")
		.styled(df_wrap)
		.child(view("div").styled(df_blob_a))
		.child(view("div").styled(df_blob_b))
		.child(grain())
		.child(view("div")
			.styled(df_row)
			.child(df_node_view(false, "the write", [t("count.set("), st("2"), t(")")]))
			.child(df_arrow_to("notify"))
			.child(df_node_view(false, "the signal", [t("SignalCell<i32> "), kw("= 2")]))
			.child(df_arrow_to("re-set"))
			.child(df_node_view(true, "the one text node", [
				t("<p>clicked "),
				kw("2"),
				t(" times</p>"),
			])))
		.child(view("p")
			.styled(art_caption)
			.text("no virtual DOM, no re-render: the subscription updates exactly one node"))
}
