// The live-DOM art: the stack-split diagram, the editor window, the
// toolchain constellation, and the dataflow strip, plus the vocabulary they
// share (stages, blobs, cards, arrows). Every stage carries an opaque ink
// ground so blend modes survive animation stacking-context isolation.

import std::style::{
	AlignItems,
	Color,
	Display,
	FlexDirection,
	Gradient,
	JustifyContent,
	Length,
	Overflow,
	Position,
	RadialExtent,
	TextAlign,
	WhiteSpace,
	space,
	style,
};
import std::ui::{ View, view };
import pkg::code::{ blank, kw, ln, st, t, tk_plain };
import pkg::theme::grain;
import pkg::theme::{
	assets,
	blush,
	desktop_only,
	display_face,
	ember,
	hairline_color,
	hairline_width,
	ink,
	mono,
	no_drag,
	no_select,
	reveal,
	rose,
};

// --- shared art vocabulary ---

// Every piece is composed on ink, its text the dark body tier — the art's own
// swatches, not the page's roles — so the canvas says so explicitly: in the
// dark theme it is indistinguishable from the ground it was drawn against
// (same ink, same #D8BEC8 the shell's `up-normal` is there), and in the light
// theme the piece stays the same picture, sitting on the page rather than
// re-lit by it. Text inside a piece inherits from here; nothing in the art was
// ever composed against a light ground.
let art_canvas = const style().background(ink).color(Color::hex("#D8BEC8"));

let art_stage = const (style()
	.position(Position::Relative)
	.overflow(Overflow::Hidden)
	+ art_canvas
	+ reveal);

let art_blob = const style()
	.position(Position::Absolute)
	.radius(Length::pct(50.0))
	.raw("filter", "blur(60px)")
	.raw("pointer-events", "none");

let art_card = const style()
	.position(Position::Relative)
	.background(Color::rgba(27, 6, 13, 0.88))
	.border(hairline_width, hairline_color)
	.radius(Length::px(14.0))
	.padding_y(space(4))
	.padding_x(space(5))
	.box_shadow("0 8px 40px rgba(0, 0, 0, 0.45)");

let art_tab = const style()
	.font_size(Length::px(11.0))
	.font_weight(600)
	.letter_spacing(Length::em(0.1))
	.raw("text-transform", "uppercase")
	.opacity(0.55)
	.margin_y(space(2));

let art_code = const style()
	.font_family(mono)
	.font_size(Length::px(12.5))
	.line_height(1.7)
	.white_space(WhiteSpace::Pre)
	.color(Color::hex("rgba(249, 223, 231, 0.92)"));

let art_caption = const style()
	.text_align(TextAlign::Center)
	.font_size(Length::px(12.0))
	.letter_spacing(Length::em(0.04))
	.opacity(0.55)
	.margin_y(space(4));

let dot = const style().width(Length::px(9.0)).height(Length::px(9.0)).radius(Length::pct(50.0));

let dot_magenta = const (dot + style().background(Color::hex("#8B2786")));
let dot_orange = const (dot + style().background(Color::hex("#EB682E")));

let arrow_head_left = const style()
	.width(Length::px(8.0))
	.height(Length::px(8.0))
	.background(Color::hex("#EB682E"))
	.raw("clip-path", "polygon(100% 0, 0 50%, 100% 100%)")
	.flex_shrink(0.0);

let arrow_head_right_rose = const style()
	.width(Length::px(8.0))
	.height(Length::px(8.0))
	.background(Color::hex("#E5AFD9"))
	.raw("clip-path", "polygon(0 0, 100% 50%, 0 100%)")
	.flex_shrink(0.0);

let arrow_head_right = const style()
	.width(Length::px(8.0))
	.height(Length::px(8.0))
	.background(Color::hex("#EB682E"))
	.raw("clip-path", "polygon(0 0, 100% 50%, 0 100%)")
	.flex_shrink(0.0);

// --- the stack-split diagram (fullstack section) ---

