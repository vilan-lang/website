// The playground entry: build the shared page, mount it, then wire the two
// empty containers to the vendored bundle (`playground/editor.js`, committed
// as `window.VilanPlayground`) — CodeMirror into `#editor`, the compile
// worker, and the per-Run sandboxed iframe into `#runner`.
//
// The split: the bundle owns the DELIVERY machinery (the editor widget, the
// worker lifecycle with its crash-respawn and recycle policy, the iframe
// swap), because all of it is inherently JavaScript — a Worker needs `new`,
// an srcdoc needs escaping. This entry owns the APPLICATION: every signal the
// page renders, and what each compiler or program event means to it.

import std::option::Option::{ None, Some, self };
import std::reactive::Signal;
import std::shared::Shared;
import std::time::Timer;
import std::ui::mount_root;
import pkg::playground_page::{ ConsoleRow, DiagRow, playground_page };

// --- the vendored bundle (playground/editor.js) ---

[extern("VilanPlayground.init")]
external fun editor_init(selector: str, doc: str): void;

[extern("VilanPlayground.value")]
external fun editor_value(): str;

[extern("VilanPlayground.setDoc")]
external fun editor_set_doc(text: str): void;

/// A seeded example's source (playground/examples/, shipped as examples.js).
[extern("VilanPlayground.example")]
external fun example_source(name: str): str;

/// Start the compile worker. The bundle respawns it after a crash and
/// recycles it after enough compiles (the wasm instance leaks by design —
/// see the D11 proposal §6); every lifecycle step arrives as an event.
[extern("VilanPlayground.startCompiler")]
external fun start_compiler(on_event: |CompilerEvent| void): void;

/// Request a compile. False when the worker is not ready or one is already
/// in flight — the bundle keeps the newest rejected source and compiles it
/// when the worker frees up, so a click is never silently lost.
[extern("VilanPlayground.compile")]
external fun request_compile(source: str): bool;

/// Format the buffer with the compiler's own formatter. The bundle reads the
/// editor, round-trips the worker, and applies the result; false when the
/// worker is busy (no queue — press again).
[extern("VilanPlayground.format")]
external fun request_format(): bool;

/// Put the buffer in the URL (deflated, base64url in the fragment — no
/// server holds anything) and copy the link. Answers as a "shared" event:
/// `copied` says whether the clipboard took it.
[extern("VilanPlayground.share")]
external fun request_share(): void;

[extern("VilanPlayground.runProgram")]
external fun run_program(js: str, css: str): void;

[extern("VilanPlayground.clearProgram")]
external fun clear_program(): void;

/// The sandboxed iframe forwards program output with `postMessage`; the page
/// listens on its own window.
[extern("window.addEventListener")]
external fun window_listen(event: str, handler: |HostEvent| void): void;

external struct CompilerEvent;

impl CompilerEvent {
	[extern(get, "kind")]
	external fun kind(self): str;

	[extern(get, "version")]
	external fun version(self): str;

	[extern(get, "ok")]
	external fun ok(self): bool;

	[extern(get, "js")]
	external fun js(self): str;

	[extern(get, "css")]
	external fun css(self): str;

	[extern(get, "error")]
	external fun error(self): str;

	/// On the "ready" event: whether the loaded wasm exports `format`.
	[extern(get, "canFormat")]
	external fun can_format(self): bool;

	/// On the "formatted" event: whether the buffer actually changed.
	[extern(get, "changed")]
	external fun changed(self): bool;

	/// On the "shared" event: whether the link reached the clipboard (the
	/// URL bar carries it either way).
	[extern(get, "copied")]
	external fun copied(self): bool;

	/// On the "command" event: what the editor or the template picker asked
	/// for ("run", "format", "pick").
	[extern(get, "command")]
	external fun command(self): str;

	/// On a "pick" command: the chosen example's name.
	[extern(get, "name")]
	external fun name(self): str;

	[extern(get, "diagnostics")]
	external fun diagnostics(self): List<WireDiagnostic>;
}

external struct WireDiagnostic;

impl WireDiagnostic {
	[extern(get, "severity")]
	external fun severity(self): str;

	[extern(get, "file")]
	external fun file(self): str;

	[extern(get, "line")]
	external fun line(self): i32;

	[extern(get, "column")]
	external fun column(self): i32;

	[extern(get, "message")]
	external fun message(self): str;

	[extern(get, "note")]
	external fun note(self): str;
}

external struct HostEvent;

impl HostEvent {
	[extern(get, "data")]
	external fun data(self): ProgramMessage;
}

external struct ProgramMessage;

impl ProgramMessage {
	[extern(get, "kind")]
	external fun kind(self): str;

	[extern(get, "text")]
	external fun text(self): str;
}

// A runaway program can print forever; past this many rows the pane notes the
// truncation once and drops the rest. Each Run starts a fresh count.
let console_cap = 300;

fun main() {
	let status = Signal::new("Loading the compiler…");
	let diagnostics: Signal<List<DiagRow>> = Signal::new([]);
	let console_lines: Signal<List<ConsoleRow>> = Signal::new([]);
	let can_format = Signal::new(false);
	let share_label = Signal::new("Share");
	let next_row_id = Shared::new(0);

	let run = || {
		if request_compile(editor_value()) {
			status.set("Compiling…");
		} else {
			status.set("Compiler busy; queued.");
		}
	};

	let format = || {
		if !request_format() {
			status.set("Compiler busy; try again.");
		}
	};

	let share = || request_share();

	let pick = |name: str| {
		editor_set_doc(example_source(name));
		diagnostics.set([]);
		console_lines.set([]);
		run();
	};

	// Run once on arrival, when the compiler is up AND the initial doc is
	// settled (a shared link inflates asynchronously; racing it would
	// compile the placeholder). Later "ready" events are worker recycles
	// and must not re-run.
	let compiler_ready = Shared::new(false);
	let doc_ready = Shared::new(false);
	let ran_on_arrival = Shared::new(false);
	let run_on_arrival = || {
		if compiler_ready.read() && doc_ready.read() && !ran_on_arrival.read() {
			ran_on_arrival.write() = true;
			run();
		}
	};

	// The Share label's flip-and-revert, the install strip's pattern: a
	// re-share cancels the pending revert before arming the next one.
	let share_revert: Shared<Option<Timer>> = Shared::new(None);
	let flash_share = |label: str| {
		share_label.set(label);
		match share_revert.read() {
			Some(let timer) => timer.cancel(),
			None => {}
		}
		let timer = Timer::after(1600);
		share_revert.write() = Some(timer);
		let _ = async {
			if timer.wait() {
				share_label.set("Share");
			}
		};
	};

	let _root = mount_root("app", || playground_page(status, diagnostics, console_lines, can_format, share_label, run, format, share));

	editor_init("#editor", example_source("counter"));

	start_compiler(|event| {
		let kind = event.kind();
		if kind == "ready" {
			can_format.set(event.can_format());
			status.set(i"Ready (vilan {event.version()})");
			compiler_ready.write() = true;
			run_on_arrival();
		} else if kind == "doc" {
			doc_ready.write() = true;
			run_on_arrival();
		} else if kind == "command" {
			let command = event.command();
			if command == "run" {
				run();
			} else if command == "format" {
				format();
			} else if command == "pick" {
				pick(event.name());
			}
		} else if kind == "formatted" {
			if event.changed() {
				status.set("Formatted.");
			} else {
				status.set("Format made no changes.");
			}
		} else if kind == "shared" {
			if event.copied() {
				status.set("Link copied to the clipboard.");
				flash_share("Copied!");
			} else {
				status.set("Link ready in the address bar.");
				flash_share("Link ready");
			}
		} else if kind == "result" {
			mut rows: List<DiagRow> = [];
			mut id = next_row_id.read();
			for diagnostic in event.diagnostics() {
				rows.push(DiagRow {
					id = id,
					severity = diagnostic.severity(),
					file = diagnostic.file(),
					line = diagnostic.line() + 1,
					column = diagnostic.column() + 1,
					message = diagnostic.message(),
					note = diagnostic.note(),
				});
				id = id + 1;
			}
			next_row_id.write() = id;
			diagnostics.set(rows);
			console_lines.set([]);
			if event.ok() {
				status.set(i"Compiled (vilan {event.version()})");
				run_program(event.js(), event.css());
			} else {
				status.set("Build failed; see the diagnostics.");
				clear_program();
			}
		} else if kind == "crash" {
			status.set("The compiler crashed on this input; it has been restarted. Please report the program that did it.");
		}
	});

	window_listen("message", |host_event| {
		let message = host_event.data();
		let kind = message.kind();
		if kind == "log" || kind == "error" {
			console_lines.set_with(|lines| {
				mut next = lines;
				if next.len() < console_cap {
					let id = next_row_id.read();
					next_row_id.write() = id + 1;
					next.push(ConsoleRow { id = id, kind = kind, text = message.text() });
				} else if next.len() == console_cap {
					let id = next_row_id.read();
					next_row_id.write() = id + 1;
					next.push(ConsoleRow { id = id, kind = "error", text = "[output truncated]" });
				}
				next
			});
		}
	});
}
