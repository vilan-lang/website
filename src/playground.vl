// The playground entry: build the shared page, mount it, then wire the two
// empty containers to the vendored bundle (`src/playground/editor.js`,
// committed as `window.VilanPlayground`) — CodeMirror into `#editor`, the
// compile worker, and the per-Run sandboxed iframe into `#runner`.
//
// The split: the bundle owns the DELIVERY machinery (the editor widget, the
// worker lifecycle with its crash-respawn and recycle policy, the iframe
// swap), because all of it is inherently JavaScript — a Worker needs `new`,
// an srcdoc needs escaping. This entry owns the APPLICATION: every signal the
// page renders, and what each compiler or program event means to it.

import std::asset::bundle;
import std::option::Option::{ None, Some, self };
import std::reactive::Signal;
import std::shared::Shared;
import std::time::Timer;
import std::ui::mount_root;
import pkg::playground_page::{ ConsoleRow, DiagRow, TraceRow, playground_page };

// --- the vendored files this leg carries into the build ---
//
// The three committed JavaScript files the playground page loads are not code
// this compiler emits, so nothing carried them into `dist/` and the deploy
// workflow copied them out of the source tree by hand (`cp playground/... `).
// `const asset::bundle` is the fix: each one becomes a build artifact of THIS
// leg, keeping its package-relative path, so the urls below are the same urls
// the page has always used — and `serve_build(playground_build)` answers them
// with no route of the server's own.
//
// The values are urls, minted by the build rather than typed from memory: a
// resource that stopped existing fails the compile here instead of 404ing in
// production. `worker.js` is named by the vendored bundle rather than by this
// entry, so its url is bound and deliberately unread — bundling it is the
// whole point.
let editor_url = const bundle("playground/editor.js");
let examples_url = const bundle("playground/examples.js");
let worker_url = const bundle("playground/worker.js");

// --- the vendored bundle (src/playground/editor.js) ---

[extern("VilanPlayground.init")]
external fun editor_init(selector: str, doc: str): void;

[extern("VilanPlayground.value")]
external fun editor_value(): str;

[extern("VilanPlayground.setDoc")]
external fun editor_set_doc(text: str): void;

/// A seeded example's source (playground/examples/, shipped as
/// src/playground/examples.js).
[extern("VilanPlayground.example")]
external fun example_source(name: str): str;

/// Start the compile worker. The bundle respawns it after a crash and
/// recycles it after enough compiles (the wasm instance leaks by design —
/// see the D11 proposal §6); every lifecycle step arrives as an event.
[extern("VilanPlayground.startCompiler")]
external fun start_compiler(on_event: |CompilerEvent| void): void;

/// Request a compile. False when the worker is not ready or one is already
/// in flight — the bundle keeps the newest rejected source and compiles it
/// when the worker frees up, so a click is never silently lost.
[extern("VilanPlayground.compile")]
external fun request_compile(source: str): bool;

/// Format the buffer with the compiler's own formatter. The bundle reads the
/// editor, round-trips the worker, and applies the result; false when the
/// worker is busy (no queue — press again).
[extern("VilanPlayground.format")]
external fun request_format(): bool;

/// Route the compiler at a leg: "browser" (compile and run) or "node" (the
/// check-only server mode). The bundle keeps the #mode select in step and
/// re-checks the buffer under the new leg; the change echoes back as a
/// "mode" command event.
[extern("VilanPlayground.setMode")]
external fun set_mode(platform: str): void;

/// Put the buffer in the URL (deflated, base64url in the fragment — no
/// server holds anything) and copy the link. Answers as a "shared" event:
/// `copied` says whether the clipboard took it.
[extern("VilanPlayground.share")]
external fun request_share(): void;

/// Mount a compiled program in a fresh sandboxed iframe. `token` is this
/// Run's name for that frame: the bundle splices it into the frame's
/// bootstrap, and every console line the frame forwards quotes it back.
[extern("VilanPlayground.runProgram")]
external fun run_program(js: str, css: str, token: str): void;

[extern("VilanPlayground.clearProgram")]
external fun clear_program(): void;

/// The sandboxed iframe forwards program output with `postMessage`; the page
/// listens on its own window. A window listener hears from ANY document that
/// holds a handle on this window — an opener, a page embedding the playground
/// in an iframe, a sibling frame — so what arrives here is untrusted until
/// `ProgramMessage::token` says otherwise.
[extern("window.addEventListener")]
external fun window_listen(event: str, handler: |HostEvent| void): void;

/// `crypto.randomUUID()` — 122 cryptographically random bits, per Run.
///
/// Why a secret rather than an origin check: the runner iframe is
/// `sandbox="allow-scripts"` with no `allow-same-origin`, so it has an OPAQUE
/// origin and its messages arrive with `origin` exactly `"null"`. `"null"` is
/// not an identity — it is what EVERY opaque-origin document presents — so a
/// page that wants to forge program output need only post from inside a
/// sandboxed frame of its own to satisfy an origin check. `event.source` is
/// the identity that would settle it, and it is the bundle, not this entry,
/// that holds the frame to compare against. A per-Run secret settles it here,
/// where the decision belongs: the sender must quote a value it can only have
/// learnt by being the document this page just started.
///
/// (`crypto.randomUUID` needs a secure context; the site is https, and
/// `localhost` counts for the dev loop.)
[extern("crypto.randomUUID")]
external fun random_uuid(): str;

external struct CompilerEvent;

impl CompilerEvent {
	[extern(get, "kind")]
	external fun kind(self): str;

	[extern(get, "version")]
	external fun version(self): str;

	[extern(get, "ok")]
	external fun ok(self): bool;

	[extern(get, "js")]
	external fun js(self): str;

	[extern(get, "css")]
	external fun css(self): str;

	[extern(get, "error")]
	external fun error(self): str;

	/// On the "ready" event: whether the loaded wasm exports `format`.
	[extern(get, "canFormat")]
	external fun can_format(self): bool;

	/// On the "ready" event: whether the loaded wasm exports `compile_for`
	/// (the server check mode; older releases do not).
	[extern(get, "canPlatform")]
	external fun can_platform(self): bool;

	/// On "result" and "checked" events: which leg the compile targeted.
	[extern(get, "platform")]
	external fun platform(self): str;

	/// On the "formatted" event: whether the buffer actually changed. On the
	/// "dirty" event: whether the buffer has diverged from the example it
	/// came from (or, for a buffer that came from no example, is non-empty).
	[extern(get, "changed")]
	external fun changed(self): bool;

	/// On the "shared" event: whether the link reached the clipboard (the
	/// URL bar carries it either way).
	[extern(get, "copied")]
	external fun copied(self): bool;

	/// On the "command" event: what the editor, the template picker or the
	/// mode select asked for ("run", "format", "pick", "mode").
	[extern(get, "command")]
	external fun command(self): str;

	/// On a "pick" command: the chosen example's name. On a "mode" command:
	/// the leg. On the "dirty" event: the example the buffer was modified
	/// from, empty when there is none to name.
	[extern(get, "name")]
	external fun name(self): str;

	[extern(get, "diagnostics")]
	external fun diagnostics(self): List<WireDiagnostic>;
}

external struct WireDiagnostic;

impl WireDiagnostic {
	[extern(get, "severity")]
	external fun severity(self): str;

	[extern(get, "file")]
	external fun file(self): str;

	[extern(get, "line")]
	external fun line(self): i32;

	[extern(get, "column")]
	external fun column(self): i32;

	[extern(get, "message")]
	external fun message(self): str;

	[extern(get, "note")]
	external fun note(self): str;

	/// The requirement chain (E78, on the wire by E80), entry → read: one
	/// entry per uncovered call on the path to a context read. Empty for
	/// every other diagnostic.
	[extern(get, "trace")]
	external fun trace(self): List<WireTraceEntry>;
}

external struct WireTraceEntry;

impl WireTraceEntry {
	[extern(get, "file")]
	external fun file(self): str;

	[extern(get, "line")]
	external fun line(self): i32;

	[extern(get, "column")]
	external fun column(self): i32;

	[extern(get, "message")]
	external fun message(self): str;

	/// Whether the entry marks an uncovered call site; false only for the
	/// chain's elision tail, whose text stands alone.
	[extern(get, "call")]
	external fun call(self): bool;
}

external struct HostEvent;

impl HostEvent {
	[extern(get, "data")]
	external fun data(self): ProgramMessage;
}

external struct ProgramMessage;

impl ProgramMessage {
	[extern(get, "kind")]
	external fun kind(self): str;

	[extern(get, "text")]
	external fun text(self): str;

	/// The Run token the sending frame was started with. A message from any
	/// other document carries no such field, and reads back as a value that
	/// matches no live token.
	[extern(get, "token")]
	external fun token(self): str;
}

// A runaway program can print forever; past this many rows the pane notes the
// truncation once and drops the rest. Each Run starts a fresh count.
let console_cap = 300;

fun main() {
	let status = Signal::new("Loading the compiler…");
	let diagnostics: Signal<List<DiagRow>> = Signal::new([]);
	let console_lines: Signal<List<ConsoleRow>> = Signal::new([]);
	let can_format = Signal::new(false);
	let can_platform = Signal::new(false);
	let mode = Signal::new("browser");
	let share_label = Signal::new("Share");
	let next_row_id = Shared::new(0);

	// The buffer's relationship to the seeded examples, as the bundle reports
	// it. `modified_from` names the example the picker's marker should call
	// out (empty when the buffer is a pristine example, and empty too when it
	// descends from none); `buffer_dirty` is the broader fact — there is work
	// in the buffer that a replacement would destroy — and it is what gates
	// the confirmation. A shared or restored program is nobody's template but
	// it is still somebody's program.
	let modified_from = Signal::new("");
	let buffer_dirty = Shared::new(false);

	// The name of the frame currently allowed to write the console: a fresh
	// secret per Run, empty whenever no program is mounted. Empty is a real
	// state and it must never match — a message arriving before the first Run
	// carries no token, and `"" == ""` would let it through.
	let run_token = Shared::new("");

	// The example a pending replacement would load, empty when none is
	// pending. It is the confirm bar's whole state: what it asks about, and
	// whether it is there at all.
	let confirm_target = Signal::new("");

	let run = || {
		if request_compile(editor_value()) {
			status.set("Compiling…");
		} else {
			status.set("Compiler busy; queued.");
		}
	};

	let format = || {
		if !request_format() {
			status.set("Compiler busy; try again.");
		}
	};

	let share = || request_share();

	// An example carries its leg: picking the server example flips the mode
	// to node (and any other example flips it back), BEFORE the doc loads so
	// the auto-run compiles under the right platform.
	let load_example = |name: str| {
		let platform = match name {
			"server" => "node",
			_ => "browser",
		};
		set_mode(platform);
		editor_set_doc(example_source(name));
		diagnostics.set([]);
		console_lines.set([]);
		run();
	};

	// Every replacement lands here — another example, or the same one again
	// (the picker offers that once the buffer diverges, which is the only way
	// back to a pristine copy). A buffer with work in it gets asked first;
	// the answer is the confirm bar's, and until it comes nothing moves. The
	// bundle already keeps the select pointed at what is actually loaded, so
	// a refusal has nothing to put back.
	let pick = |name: str| {
		if buffer_dirty.read() {
			confirm_target.set(name);
		} else {
			load_example(name);
		}
	};

	let confirm_replace = || {
		let name = confirm_target.get();
		confirm_target.set("");
		if name != "" {
			load_example(name);
		}
	};

	let cancel_replace = || confirm_target.set("");

	// Run once on arrival, when the compiler is up AND the initial doc is
	// settled (a shared link inflates asynchronously; racing it would
	// compile the placeholder). Later "ready" events are worker recycles
	// and must not re-run.
	let compiler_ready = Shared::new(false);
	let doc_ready = Shared::new(false);
	let ran_on_arrival = Shared::new(false);
	let run_on_arrival = || {
		if compiler_ready.read() && doc_ready.read() && !ran_on_arrival.read() {
			ran_on_arrival.write() = true;
			run();
		}
	};

	// The Share label's flip-and-revert, the install strip's pattern: a
	// re-share cancels the pending revert before arming the next one.
	let share_revert: Shared<Option<Timer>> = Shared::new(None);
	let flash_share = |label: str| {
		share_label.set(label);
		match share_revert.read() {
			Some(let timer) => timer.cancel(),
			None => {}
		}
		let timer = Timer::after(1600);
		share_revert.write() = Some(timer);
		let _ = async {
			if timer.wait() {
				share_label.set("Share");
			}
		};
	};

	// Both a Run's result and a live check carry the same diagnostics shape;
	// one applier fills the pane and answers how many problems there were.
	let apply_diagnostics = |event: CompilerEvent| {
		mut rows: List<DiagRow> = [];
		mut id = next_row_id.read();
		for diagnostic in event.diagnostics() {
			mut trace: List<TraceRow> = [];
			for hop in diagnostic.trace() {
				trace.push(TraceRow {
					file = hop.file(),
					line = hop.line() + 1,
					column = hop.column() + 1,
					message = hop.message(),
					call = hop.call(),
				});
			}
			rows.push(DiagRow {
				id = id,
				severity = diagnostic.severity(),
				file = diagnostic.file(),
				line = diagnostic.line() + 1,
				column = diagnostic.column() + 1,
				message = diagnostic.message(),
				note = diagnostic.note(),
				trace = trace,
			});
			id = id + 1;
		}
		next_row_id.write() = id;
		diagnostics.set(rows);
		rows.len()
	};

	let _root = mount_root("app", || playground_page(status, diagnostics, console_lines, can_format, can_platform, share_label, mode, modified_from, confirm_target, run, format, share, confirm_replace, cancel_replace));

	editor_init("#editor", example_source("counter"));

	start_compiler(|event| {
		let kind = event.kind();
		if kind == "ready" {
			can_format.set(event.can_format());
			can_platform.set(event.can_platform());
			if !event.can_platform() {
				// An older pinned compiler has no server leg; fall back
				// rather than pretend to check.
				set_mode("browser");
			}
			status.set(i"Ready (vilan {event.version()})");
			compiler_ready.write() = true;
			run_on_arrival();
		} else if kind == "doc" {
			doc_ready.write() = true;
			run_on_arrival();
		} else if kind == "dirty" {
			buffer_dirty.write() = event.changed();
			modified_from.set(event.name());
			// A replacement the visitor is still deciding about is stale the
			// moment the buffer becomes replaceable — a Format or an undo
			// back to the pristine text answers the question by itself.
			if !event.changed() {
				confirm_target.set("");
			}
		} else if kind == "command" {
			let command = event.command();
			if command == "run" {
				run();
			} else if command == "format" {
				format();
			} else if command == "pick" {
				pick(event.name());
			} else if command == "mode" {
				mode.set(event.name());
			}
		} else if kind == "formatted" {
			if event.changed() {
				status.set("Formatted.");
			} else {
				status.set("Format made no changes.");
			}
		} else if kind == "shared" {
			if event.copied() {
				status.set("Link copied to the clipboard.");
				flash_share("Copied!");
			} else {
				status.set("Link ready in the address bar.");
				flash_share("Link ready");
			}
		} else if kind == "checked" {
			// A live check: diagnostics move, the running program does not.
			let count = apply_diagnostics(event);
			if event.ok() {
				if event.platform() == "node" {
					status.set(i"No problems (server check, vilan {event.version()}).");
				} else {
					status.set(i"No problems (vilan {event.version()}).");
				}
			} else if count == 1 {
				status.set("1 problem; see the diagnostics.");
			} else {
				status.set(i"{count} problems; see the diagnostics.");
			}
		} else if kind == "result" {
			let _count = apply_diagnostics(event);
			if event.platform() == "node" {
				// Server results are checks: the browser has no process host,
				// so the mounted program and its console are left alone.
				if event.ok() {
					status.set(i"Server program checks clean (vilan {event.version()}).");
				} else {
					status.set("Build failed; see the diagnostics.");
				}
			} else {
				console_lines.set([]);
				if event.ok() {
					status.set(i"Compiled (vilan {event.version()})");
					// The token is rotated BEFORE the frame exists, so the
					// previous Run's frame — which is torn down by this call,
					// but whose in-flight messages may still be queued — can no
					// longer write into the console this Run just cleared.
					let token = random_uuid();
					run_token.write() = token;
					run_program(event.js(), event.css(), token);
				} else {
					status.set("Build failed; see the diagnostics.");
					run_token.write() = "";
					clear_program();
				}
			}
		} else if kind == "crash" {
			status.set("The compiler crashed on this input; it has been restarted. Please report the program that did it.");
		}
	});

	window_listen("message", |host_event| {
		let message = host_event.data();
		let expected = run_token.read();
		let kind = message.kind();
		// Only the frame this page started, and only while it is the mounted
		// one. Everything else — an embedder, an opener, a stale frame from a
		// previous Run — is silently dropped: a console that can be written by
		// any page holding a handle on this window is not this program's
		// output, and saying so on screen would only lend the injection a
		// voice.
		if expected != "" && message.token() == expected && (kind == "log" || kind == "error") {
			console_lines.set_with(|lines| {
				mut next = lines;
				if next.len() < console_cap {
					let id = next_row_id.read();
					next_row_id.write() = id + 1;
					next.push(ConsoleRow { id = id, kind = kind, text = message.text() });
				} else if next.len() == console_cap {
					let id = next_row_id.read();
					next_row_id.write() = id + 1;
					next.push(ConsoleRow { id = id, kind = "error", text = "[output truncated]" });
				}
				next
			});
		}
	});
}
