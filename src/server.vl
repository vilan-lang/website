// The server, at rung 2 (fullstack-dx.md §5.5): each page's document is
// WRITTEN from its leg's build — `Document::of` derives the doctype, the
// charset/viewport pair, the `<title>`, the stylesheet link, the mount div and
// the module script from what the build emitted, so none of them can disagree
// with the artifacts they name — and `serve_build` serves those artifacts on
// the routes the document writes. There are no HTML shells and no `<!--ssr-->`
// marker any more: `Document::render(view)` splices the server render INSIDE
// the mount element the document itself wrote. What no build can know — the
// UA theme metas, the icons, the social cards, the self-hosted fonts, each
// page's frame rules, the playground's vendored scripts — rides the
// `head()`/`body()` hatches below, and each hatch says why it exists.
//
// The playground's wasm compiler is NOT part of this package's build: in
// production the deploy job downloads it from the toolchain's release assets,
// and locally `scripts/fetch-wasm.sh` puts it under playground/wasm/ (see the
// README). The routes below answer 404 with a pointer until it exists, so the
// landing page needs none of it.

import std::build::{ LegBuild, require_build };
import std::bytes::Bytes;
// `Display` is `List::join`'s bound — the import is what puts the method in
// scope (std-surface.md: discoverability follows the declaring file).
import std::display::Display;
import std::document::Document;
import std::fs;
import std::http::{ Response, Server };
import std::option::Option::{ None, Some, self };
import std::print;
import std::process::env;
import std::reactive::Signal;
import pkg::page::page;
import pkg::playground_page::{ ConsoleRow, DiagRow, playground_page };
import pkg::theme::{ fallback, theme_metas };

/// One fetched compiler version's pair, served at its versioned paths.
struct WasmPair {
	version: str,
	glue: str,
	gz: Bytes,
}

fun html(markup: str): Response {
	Response::builder().set_header("Content-Type", "text/html").body(markup).build()
}

fun script(body: str): Response {
	Response::builder().set_header("Content-Type", "text/javascript").body(body).build()
}

fun missing_wasm(): Response {
	Response::builder()
		.code(404)
		.set_header("Content-Type", "text/plain")
		.body("The playground compiler is not fetched; run scripts/fetch-wasm.sh first.")
		.build()
}

/// The one `<head>` stack both pages ride, parameterized by what differs —
/// one `head()` call per item, which std lands one per line (E86; the
/// hand-rolled `joined()` this file carried existed only to fake that).
/// Everything here is what `Document::of` deliberately does not derive:
///
/// - the UA theme metas — `theme_metas("down-dim")`, written from theme.vl's
///   own table (K17), so the UA's copy of the ground can never drift from
///   the palette it restates. Dark is the default, light follows the OS
///   (theme.vl's token block is redeclared behind `prefers-color-scheme:
///   light`); the UA is told both so its own chrome — form controls,
///   scrollbars — agrees with the page, and `theme-color` paints the browser
///   frame with the page's ground in each scheme.
/// - the page's description and its social card (og:/twitter:) — a page's
///   identity beyond its `<title>`, which is the one identity line the
///   document does carry.
/// - the icon set, absolute so the exported pages and the local server agree.
/// - the page's `<style>` block (`style_block` below).
fun with_head(
	document: Document,
	description: str,
	og_title: str,
	og_description: str,
	og_url: str,
	style: str,
): Document {
	document
		.head(theme_metas("down-dim"))
		.head(i"<meta name=\"description\" content=\"{description}\">")
		.head("<link rel=\"icon\" href=\"https://vilan-lang.org/favicon.ico\" sizes=\"48x48\">")
		.head("<link rel=\"icon\" href=\"https://vilan-lang.org/assets/icon-192.png\" type=\"image/png\" sizes=\"192x192\">")
		.head("<link rel=\"apple-touch-icon\" href=\"https://vilan-lang.org/assets/apple-touch-icon.png\">")
		.head(i"<meta property=\"og:title\" content=\"{og_title}\">")
		.head(i"<meta property=\"og:description\" content=\"{og_description}\">")
		.head("<meta property=\"og:image\" content=\"https://vilan-lang.org/assets/social_card.png\">")
		.head(i"<meta property=\"og:url\" content=\"{og_url}\">")
		.head("<meta property=\"og:type\" content=\"website\">")
		.head("<meta name=\"twitter:card\" content=\"summary_large_image\">")
		.head(style)
}

/// Each page's inline `<style>`: the shared frame first, then the page's own
/// rules, then the reduced-motion kill last so it wins.
///
/// The self-hosted webfonts (OFL): Inter is the variable file, one face for
/// every weight; Vilan Display is Raleway 600, subset to latin and renamed —
/// "Raleway" is a Reserved Font Name, and the OFL reserves it for the
/// unmodified font (see assets/fonts/VILAN-DISPLAY-LICENSE.txt). CommitMono
/// V143 is the code face for every vilan surface (the ratified spec,
/// design-language.md 2.3): 200–700 is the font's REAL wght axis range, so
/// declaring it keeps the axis live and lets the browser refuse to synthesize
/// outside it, and `font-synthesis: none` for the same reason — a faked bold
/// on a mono face breaks the grid. The feature settings (ss01–ss05,
/// cv04/cv06/cv08) are NOT set here: they are a token in theme.vl, applied per
/// code surface. Both pages declare the same three faces, so navigating
/// between them costs no new fetches.
///
/// The frame rules: the body takes the page's ground so there is never a
/// white flash outside the app, and selection inverts the page — the ground
/// on the brightest text.
fun style_block(page_rules: List<str>): str {
	mut lines: List<str> = [
		"@font-face {",
		"\tfont-family: \"Inter\";",
		"\tfont-style: normal;",
		"\tfont-weight: 100 900;",
		"\tfont-display: swap;",
		"\tsrc: url(https://vilan-lang.org/assets/fonts/inter-latin.woff2) format(\"woff2\");",
		"}",
		"@font-face {",
		"\tfont-family: \"Vilan Display\";",
		"\tfont-style: normal;",
		"\tfont-weight: 600;",
		"\tfont-display: swap;",
		"\tsrc: url(https://vilan-lang.org/assets/fonts/vilan-display-600-latin.woff2) format(\"woff2\");",
		"}",
		"@font-face {",
		"\tfont-family: \"CommitMonoV143\";",
		"\tfont-style: normal;",
		"\tfont-weight: 200 700;",
		"\tfont-display: swap;",
		"\tfont-synthesis: none;",
		"\tsrc: url(https://vilan-lang.org/assets/fonts/commit-mono-v143.woff2) format(\"woff2\");",
		"}",
		// The frame paints before the compiled stylesheet arrives, so each
		// role rides with its fallback — the table's own dark value, via
		// `fallback` (K17), never a hex stated here.
		i"html, body \{ margin: 0; height: 100%; background: {fallback("down-dim")}; \}",
		i"::selection \{ background: {fallback("up-bright")}; color: {fallback("down-dim")}; \}",
	];
	for rule in page_rules {
		lines.push(rule);
	}
	lines.push("@media (prefers-reduced-motion: reduce) {");
	lines.push("\t* { animation: none !important; }");
	lines.push("}");
	// One more indent level than the hatch: these lines live INSIDE the
	// `<style>` element (std's own `join`, since E86 retired the hand-rolled
	// helper).
	"<style>\n\t\t\t" + lines.join("\n\t\t\t") + "\n\t\t</style>"
}

/// The landing page's document. Its own style rules are the three animations
/// the page's art references by name: the hero bloom's drift (small amplitude
/// on purpose — weather, not motion), the diagram's mirror line flowing toward
/// its arrow, and the editor art's caret. The `body()` hatch carries the
/// design's Texture effect (scale reduced: the exported 200 smears far beyond
/// what the design tool renders): fine noise displacing the blurred bloom,
/// which the page references as a CSS filter. It rides OUTSIDE the mount div
/// so the client's render-and-replace never removes it.
fun landing_document(build: LegBuild): Document {
	// The texture filter is ONE element — its lines join inside the one
	// `body()` call, at the hatch's indent.
	let texture: List<str> = [
		"<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\">",
		"\t<filter id=\"bloom-texture\" x=\"-8%\" y=\"-8%\" width=\"116%\" height=\"116%\" color-interpolation-filters=\"sRGB\">",
		"\t\t<feTurbulence type=\"fractalNoise\" baseFrequency=\"0.76923\" numOctaves=\"3\" seed=\"3030\"/>",
		"\t\t<feDisplacementMap in=\"SourceGraphic\" scale=\"90\" xChannelSelector=\"R\" yChannelSelector=\"G\"/>",
		"\t</filter>",
		"</svg>",
	];
	with_head(Document::of(build).title("Vilan — The Modern Web Language"), "Vilan is a language for building full-stack web apps: one small toolchain, reactive UI, and a compiler that checks what you usually find out at runtime.", "Vilan — The Modern Web Language", "A language for building full-stack web apps: one small toolchain, reactive UI, and a compiler that checks what you usually find out at runtime.", "https://vilan-lang.org/", style_block(["@keyframes bloom-drift-a {", "\tfrom { transform: translate(0, 0) scale(1); }", "\tto { transform: translate(0.8%, 1.6%) scale(1.035); }", "}", "@keyframes dash-flow {", "\tto { background-position: 22px 0; }", "}", "@keyframes caret-blink {", "\t0%, 49% { opacity: 1; }", "\t50%, 100% { opacity: 0; }", "}"])).body(texture.join("\n\t\t"))
}

/// The playground page's document. Its own style rules size the workbench:
/// the editor host is a plain div until CodeMirror mounts, and the widget and
/// the per-Run iframe both fill whatever box the page gives them — `#app`
/// spans the viewport so the workbench can flex to the fold. The `body()`
/// hatch loads the vendored editor bundle (CodeMirror 6 + the worker and
/// iframe machinery) and the generated example table as plain scripts, so
/// both globals exist before the document's own module script runs — the
/// generated tag lands after the hatch, which is exactly that order.
fun playground_document(build: LegBuild): Document {
	with_head(Document::of(build).title("Vilan Playground — run vilan in your browser"), "Write and run Vilan in your browser: the compiler itself runs client-side as WebAssembly — no install, no server.", "Vilan Playground", "Write and run Vilan in your browser: the compiler itself runs client-side as WebAssembly — no install, no server.", "https://vilan-lang.org/playground/", style_block(["#app { height: 100%; }", "#editor .cm-editor { height: 100%; }", "#runner iframe { border: 0; width: 100%; height: 100%; background: #fff; }", "button:focus-visible, select:focus-visible {", i"\toutline: 2px solid {fallback("primary")};", "\toutline-offset: 2px;", "}"]))
		.body("<script src=\"/playground/examples.js\"></script>")
		.body("<script src=\"/playground/editor.js\"></script>")
}

async fun main() {
	// What each browser leg's build wrote, as the build knows it — the server
	// runs from the project root (`vilan run .`). `serve_build` below installs
	// one route per artifact (/client.js, /client.css, /playground.js,
	// /playground.css), so nothing here names a bundle or a content type.
	let client_build = require_build("client");
	let playground_build = require_build("playground");

	let landing = landing_document(client_build);
	let playground = playground_document(playground_build);

	// The vendored playground pieces used to be files rather than build
	// artifacts, so they had three boot reads and three literal routes here.
	// They ARE build artifacts now: `src/playground.vl` carries them with
	// `const asset::bundle`, the playground leg's manifest names them, and
	// `serve_build(playground_build)` below answers `/playground/editor.js`,
	// `/playground/examples.js` and `/playground/worker.js` with no route of
	// this server's own — at the same urls, since a bundled resource keeps its
	// package-relative path.

	// The wasm pairs are fetched, not built here; absent is a normal state.
	// scripts/fetch-wasm.sh lays each version out under its own directory,
	// mirroring how the pages repo serves them; every fetched version is
	// served so the selector can switch locally too.
	let has_wasm = fs::stat("playground/wasm/VERSION").is_some();
	mut wasm_manifest = "";
	mut wasm_pairs: List<WasmPair> = [];
	if has_wasm {
		wasm_manifest = fs::read_file_to_str("playground/wasm/manifest.json");
		for name in fs::read_dir("playground/wasm") {
			if name.starts_with("v") {
				wasm_pairs.push(WasmPair {
					version = name,
					glue = fs::read_file_to_str(i"playground/wasm/{name}/vilan_wasm.js"),
					gz = fs::read_bytes(i"playground/wasm/{name}/vilan_wasm_bg.wasm.gz"),
				});
			}
		}
	}

	// 3000 is every tool's favourite port; PORT overrides for the day
	// something else is squatting on it.
	let port = match env("PORT") {
		Some(let value) => value.parse_i32().unwrap_or(3000),
		None => 3000,
	};

	// Inert stand-ins, the same split as the landing page: the signals never
	// move and the actions do nothing — the playground entry wires the live
	// versions on boot. Create, serialize, discard: a fresh view is rendered
	// into a copy of the document per request, and no subscription survives
	// the response. (Pages serves the exported page at /playground/, the
	// local server at /playground; both spellings answer.)
	let render_playground = || {
		let no_diagnostics: Signal<List<DiagRow>> = Signal::new([]);
		let no_console: Signal<List<ConsoleRow>> = Signal::new([]);
		html(playground
			.render(playground_page(Signal::new("Loading the compiler…"), no_diagnostics, no_console, Signal::new(false), Signal::new(false), Signal::new("Share"), Signal::new("browser"), Signal::new(""), Signal::new(""), || {}, || {}, || {}, || {}, || {}))
			.html())
	};

	Server::builder()
		.port(port)
		.serve_build(client_build)
		.serve_build(playground_build)
		.on_request(|request| {
			// The path alone: a module worker's `?v=` pin (or any query)
			// must not defeat the literal routes - static hosting ignores
			// queries, so the local server does too.
			let path = request.path().split("?")[0];
			match path {
				"/playground/manifest.json" => match has_wasm {
					true => Response::builder().set_header("Content-Type", "application/json").body(wasm_manifest).build(),
					false => missing_wasm(),
				},
				"/playground" => render_playground(),
				"/playground/" => render_playground(),
				_ => {
					// The versioned wasm paths depend on which releases were
					// fetched, so they route here rather than as literals.
					for pair in wasm_pairs {
						if path == i"/playground/{pair.version}/vilan_wasm.js" {
							ret script(pair.glue);
						}
						if path == i"/playground/{pair.version}/vilan_wasm_bg.wasm.gz" {
							ret Response::builder()
								.set_header("Content-Type", "application/octet-stream")
								.body_bytes(pair.gz)
								.build();
						}
					}
					// The landing page for everything else, freshly rendered:
					// inert stand-ins for the client's enhancements — the fade
					// signal never moves and the clipboard hook does nothing.
					html(landing.render(page(Signal::new("0"), |_text| {})).html())
				}
			}
		})
		.on_start(|server| print(i"vilan website: {server.url()}"))
		.build()
		.start();
}
