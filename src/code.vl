// Code presentation: the highlighted code panels (keyword/string/plain spans
// over a pre) and the inline code leafs - `[rpc]`, `vilan upgrade`, and
// friends read as code, not bare prose; the linked flavor jumps to the docs.

import std::style::{ Length, Overflow, WhiteSpace, space, style };
import std::ui::{ View, view };
import pkg::theme::{
	accent,
	code_callable,
	code_size,
	code_type,
	down_bright,
	down_normal,
	hairline_width,
	primary,
	radius_flat,
	radius_panel,
	stroke_hard,
	up_bright,
	up_normal,
};

// --- code panels ---

// A panel sits ON the ground: `down-normal` behind it, a hard hairline around
// it, and the panel radius. `code_type` carries the face AND its feature
// settings, so no code surface can wear one without the other.
let code_pre = const (style()
	.overflow(Overflow::Auto)
	.padding(space(5))
	.margin(space(0))
	.font_size(code_size)
	.line_height(1.65)
	.white_space(WhiteSpace::Pre)
	.background(down_normal)
	.radius(radius_panel)
	.border(hairline_width, stroke_hard)
	+ code_type);

// The palette the playground's editor also speaks — and now speaks FROM: K10
// moved the CodeMirror theme onto theme.vl's `code_palette`, so these spans
// and the editor's tokens are two readings of one source and there is nothing
// left to resync. `primary` keywords, `accent` literals, bright bold types,
// and `code_callable` — the one derived tint, primary pulled toward the up
// ladder — for callables. An i-string's hole braces mark themselves in
// `primary`.
let tk_keyword = const style().color(primary);
let tk_string = const style().color(accent);
// Plain code text is the body tier; types below claim the bright tier, so the
// panel gets its hierarchy from the `up` ladder rather than from opacity.
let tk_plain = const style().color(up_normal);
let tk_callable = const style().color(code_callable);
let tk_type = const style().font_weight(600).color(up_bright);
let tk_hole = const style().color(primary);

fun kw(text: str): View {
	view("span").styled(tk_keyword).text(text)
}

fun st(text: str): View {
	view("span").styled(tk_string).text(text)
}

fun t(text: str): View {
	view("span").styled(tk_plain).text(text)
}

/// A callable at its call (or definition) site.
fun fn(text: str): View {
	view("span").styled(tk_callable).text(text)
}

/// A type or variant name.
fun ty(text: str): View {
	view("span").styled(tk_type).text(text)
}

/// An interpolation hole's brace — the seam between string and code.
fun hl(text: str): View {
	view("span").styled(tk_hole).text(text)
}

fun ln(spans: List<View>): View {
	view("div").children(spans)
}

fun blank(): View {
	view("div").text(" ")
}

fun code_panel(lines: List<View>): View {
	view("pre").styled(code_pre).children(lines)
}

// Inline code leaf — `[rpc]`, `vilan upgrade`, and friends read as code, not
// bare prose. The linked flavor also jumps to the docs.
// A leaf is a chip raised out of the prose it sits in: `down-bright`, the
// flat radius, and the tightest padding on the page.
let leaf_style = const (style()
	.padding_y(Length::px(1.0))
	.padding_x(Length::px(6.0))
	.font_size(Length::px(12.0))
	.white_space(WhiteSpace::Nowrap)
	.background(down_bright)
	.radius(radius_flat)
	.border(hairline_width, stroke_hard)
	+ code_type);

let leaf_link_style = const (leaf_style + style()
	.color(up_bright)
	.text_decoration("underline dotted rgb(from var(--primary) r g b / 0.7) 1px")
	.raw("text-underline-offset", "3px")
	.hover(style().border_color(primary)));

fun leaf(text: str): View {
	view("code").styled(leaf_style).text(text)
}

fun leaf_link(href: str, text: str): View {
	view("a").styled(leaf_link_style).attr("href", href).text(text)
}

/// A plain prose span, for paragraphs composed of text and leafs.
fun pt(text: str): View {
	view("span").text(text)
}
